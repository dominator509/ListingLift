# ─────────────────────────────────────────────────────
# ListingLift Environment Variables
# ─────────────────────────────────────────────────────
# Copy this to .env and fill in your values.
# Secrets marked [REQUIRED] must be set in production.
# All boolean/X_ENABLED vars default to false/disabled.
# ─────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database?schema=public

# ── Authentication ──────────────────────────────────
SESSION_SECRET=                                        # [REQUIRED] min 32 chars
ENCRYPTION_KEY=                                        # [REQUIRED] min 16 chars
CSRF_SECRET=                                           # Falls back to SESSION_SECRET

# ── Tokens ──────────────────────────────────────────
UPLOAD_TOKEN_SECRET=                                   # [REQUIRED] min 16 chars
DELIVERY_TOKEN_SECRET=                                 # [REQUIRED] min 16 chars

# ── Application ─────────────────────────────────────
APP_URL=http://localhost:3000

# ── Mocks / Feature Flags ───────────────────────────
MOCK_IMAGE_PROVIDER_ENABLED=true
REAL_IMAGE_PROVIDER_CALLS_ENABLED=false
MOCK_INTEGRATIONS_ENABLED=true
REAL_INTEGRATIONS_ENABLED=false
MOCK_EMAIL_DELIVERY_ENABLED=true
EMAIL_PROVIDER=mock-email

# ── Rate Limiting ───────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Logging ─────────────────────────────────────────
LOG_LEVEL=info

# ── Stripe ──────────────────────────────────────────
STRIPE_ENABLED=false
STRIPE_TEST_MODE=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_QUICK_CLEANUP=
STRIPE_PRICE_MARKETPLACE_LISTING=
STRIPE_PRICE_PRODUCT_LAUNCH=
STRIPE_PRICE_MONTHLY_RETAINER=
STRIPE_PRICE_AGENCY_WHITE_LABEL=

# ── Gumroad ─────────────────────────────────────────
GUMROAD_ENABLED=false
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PRODUCT_QUICK_CLEANUP_10=
GUMROAD_PRODUCT_MARKETPLACE_LISTING_25=
GUMROAD_PRODUCT_MARKETPLACE_LISTING_50=
GUMROAD_PRODUCT_MONTHLY_CREDIT_PACK=
GUMROAD_PRODUCT_PRODUCT_LAUNCH_KIT=
GUMROAD_PRODUCT_AGENCY_STARTER=

# ── Email ───────────────────────────────────────────
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ── Image Processing ────────────────────────────────
REMOVE_BG_ENABLED=false
REMOVE_BG_API_KEY=
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REPLICATE_ENABLED=false
REPLICATE_API_TOKEN=
CLIPDROP_STYLE_ENABLED=false
CLIPDROP_STYLE_API_KEY=

# ── File Storage ────────────────────────────────────
GOOGLE_DRIVE_ENABLED=false
DROPBOX_ENABLED=false
ONEDRIVE_ENABLED=false
BOX_ENABLED=false

# ── Marketplace / Freelance Channels ────────────────
FIVERR_ENABLED=false
FIVERR_MANUAL_WORKFLOW_ENABLED=true
FIVERR_ORDER_IMPORT_ENABLED=false
FIVERR_DELIVERY_LINKS_REQUIRE_OPERATOR_CONFIRMATION=true
UPWORK_ENABLED=false
TASKRABBIT_ENABLED=false
FREELANCER_ENABLED=false
PEOPLEPERHOUR_ENABLED=false
GURU_ENABLED=false
CONTRA_ENABLED=false
THUMBTACK_ENABLED=false
BARK_ENABLED=false
HOUZZ_ENABLED=false
ETSY_ENABLED=false

# ── E-Commerce ──────────────────────────────────────
SHOPIFY_ENABLED=false
SHOPIFY_OAUTH_ENABLED=false
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_WEBHOOK_SECRET=

# ── Social Commerce ─────────────────────────────────
TIKTOK_SHOP_ENABLED=false
FACEBOOK_BUSINESS_PAGE_ENABLED=false
TIKTOK_PROFILE_ENABLED=false
SOCIAL_COMMERCE_WORKFLOWS_ENABLED=true
SOCIAL_COMMERCE_AUTOMATION_ENABLED=false
INSTAGRAM_SHOP_ENABLED=false
INSTAGRAM_PROFILE_ENABLED=false
FACEBOOK_MARKETPLACE_ENABLED=false
PINTEREST_ENABLED=false
YOUTUBE_SHORTS_ENABLED=false
GOOGLE_BUSINESS_PROFILE_SOCIAL_ENABLED=false

# ── Automation Webhooks ─────────────────────────────
ZAPIER_WEBHOOKS_ENABLED=false
MAKE_WEBHOOKS_ENABLED=false
N8N_WEBHOOKS_ENABLED=false
SLACK_ENABLED=false
GOOGLE_SHEETS_ENABLED=false
AIRTABLE_ENABLED=false
TRELLO_ENABLED=false
CLICKUP_ENABLED=false
ASANA_ENABLED=false
NOTION_ENABLED=false
AUTOMATION_WEBHOOKS_ENABLED=false
GENERIC_AUTOMATION_WEBHOOKS_ENABLED=false
AUTOMATION_WEBHOOK_SIGNING_SECRET=
AUTOMATION_WEBHOOK_MAX_RETRIES=3
AUTOMATION_WEBHOOK_RATE_LIMIT_PER_MINUTE=30
AUTOMATION_WEBHOOK_DISPATCH_ENABLED=false

# ── Billing ─────────────────────────────────────────
MANUAL_INVOICES_ENABLED=true
CREDIT_LEDGER_ENABLED=true
SUBSCRIPTION_ENTITLEMENTS_ENABLED=true
