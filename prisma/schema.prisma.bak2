  CREATE_SLACK_MESSAGE
  CREATE_TRELLO_CARD
  CREATE_CLICKUP_TASK
  CREATE_GOOGLE_DRIVE_FOLDER
  EXPORT_ZIP
  UPDATE_CRM
  NOTIFY_ADMIN
}

enum AutomationWebhookSubscriptionStatus {
  DRAFT
  ENABLED
  PAUSED
  FAILED
  DISABLED
  REVOKED
}

enum AutomationWebhookDeliveryStatus {
  PLANNED
  QUEUED
  SENT
  SKIPPED
  FAILED
  DEAD_LETTERED
}

model AutomationWebhookSubscription {
  id                String                              @id @default(cuid())
  organizationId    String
  organization      Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey       AutomationWebhookProviderKey
  displayName       String
  status            AutomationWebhookSubscriptionStatus @default(DRAFT)
  triggerKeys       AutomationTriggerKey[]              @default([])
  actionKeys        AutomationActionKey[]               @default([])
  endpointUrl       String?
  encryptedSecretId String?
  encryptedSecret   EncryptedSecret?                    @relation(fields: [encryptedSecretId], references: [id])
  config            Json                                @default("{}")
  maxRetries        Int                                 @default(3)
  lastDispatchAt    DateTime?
  lastError         String?
  createdByUserId   String?
  updatedByUserId   String?
  revokedAt         DateTime?
  createdAt         DateTime                            @default(now())
  updatedAt         DateTime                            @updatedAt
  deliveries        AutomationWebhookDelivery[]
  deadLetters       AutomationDeadLetter[]

  @@unique([organizationId, providerKey, displayName])
  @@index([organizationId, providerKey, status])
}

model AutomationWebhookDelivery {
  id              String                          @id @default(cuid())
  organizationId  String
  organization    Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId  String?
  subscription    AutomationWebhookSubscription?  @relation(fields: [subscriptionId], references: [id])
  providerKey     AutomationWebhookProviderKey
  triggerKey      AutomationTriggerKey
  actionKey       AutomationActionKey
  status          AutomationWebhookDeliveryStatus @default(PLANNED)
  jobId           String?
  job             Job?                            @relation(fields: [jobId], references: [id])
  dedupeKey       String
  payload         Json                            @default("{}")
  redactedPayload Json                            @default("{}")
  responseStatus  Int?
  responseBody    String?
  attemptCount    Int                             @default(0)
  maxRetries      Int                             @default(3)
  nextRetryAt     DateTime?
  sentAt          DateTime?
  failedAt        DateTime?
  createdAt       DateTime                        @default(now())
  updatedAt       DateTime                        @updatedAt
  deadLetters     AutomationDeadLetter[]

  @@unique([organizationId, dedupeKey, actionKey, providerKey])
  @@index([organizationId, providerKey, status])
  @@index([organizationId, triggerKey, actionKey])
  @@index([organizationId, jobId])
}

model AutomationDeadLetter {
  id               String                         @id @default(cuid())
  organizationId   String
  organization     Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionId   String?
  subscription     AutomationWebhookSubscription? @relation(fields: [subscriptionId], references: [id])
  deliveryId       String?
  delivery         AutomationWebhookDelivery?     @relation(fields: [deliveryId], references: [id])
  reason           String
  payload          Json                           @default("{}")
  replayedAt       DateTime?
  replayedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, resolvedAt])
}

