enum AdminDashboardWidgetStatus {
  VISIBLE
  HIDDEN
  DISMISSED
}

enum RetainerAlertStatus {
  OPEN
  DISMISSED
  CONVERTED
  ARCHIVED
}

model AdminDashboardPreference {
  id             String                     @id @default(cuid())
  organizationId String
  userId         String
  defaultSection String                     @default("OVERVIEW")
  hiddenWidgets  String[]                   @default([])
  widgetStatus   AdminDashboardWidgetStatus @default(VISIBLE)
  metadata       Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId])
}

model RevenueAnalyticsSnapshot {
  id                     String    @id @default(cuid())
  organizationId         String
  sourceChannelKey       String?
  sourceChannelName      String?
  sourceChannelType      String?
  periodStart            DateTime?
  periodEnd              DateTime?
  orderCount             Int       @default(0)
  jobCount               Int       @default(0)
  completedJobCount      Int       @default(0)
  grossRevenueCents      Int       @default(0)
  refundCents            Int       @default(0)
  netRevenueCents        Int       @default(0)
  currency               String    @default("USD")
  directConversionCount  Int       @default(0)
  retainerCandidateCount Int       @default(0)
  metadata               Json?
  capturedAt             DateTime  @default(now())
  createdAt              DateTime  @default(now())

  @@index([organizationId, capturedAt])
  @@index([organizationId, sourceChannelKey])
}

model MarketplaceDirectConversionSignal {
  id                    String    @id @default(cuid())
  organizationId        String
  clientId              String?
  marketplaceSource     String
  directSource          String?
  marketplaceOrderCount Int       @default(0)
  directOrderCount      Int       @default(0)
  grossRevenueCents     Int       @default(0)
  currency              String    @default("USD")
  manualReviewRequired  Boolean   @default(true)
  metadata              Json?
  lastOrderAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([organizationId, clientId])
  @@index([organizationId, lastOrderAt])
}

model RetainerOpportunityAlert {
  id                   String              @id @default(cuid())
  organizationId       String
  clientId             String?
  sourceChannel        String?
  completedJobs        Int                 @default(0)
  deliveredImages      Int                 @default(0)
  score                Int                 @default(0)
  priority             String              @default("LOW")
  status               RetainerAlertStatus @default(OPEN)
  suggestedAction      String
  manualReviewRequired Boolean             @default(true)
  dismissedAt          DateTime?
  convertedAt          DateTime?
  metadata             Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([organizationId, status, score])
  @@index([organizationId, clientId])
}

model AdminDashboardEvent {
  id             String                  @id @default(cuid())
  organizationId String
  userId         String?
  clientId       String?
  jobId          String?
  section        String
  eventType      AdminDashboardEventType
  sourceChannel  String?
  metadata       Json?
  createdAt      DateTime                @default(now())

  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, jobId, createdAt])
}

