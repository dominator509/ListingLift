  dueAt          DateTime?
  labels         String[]                    @default([])
  externalId     String?
  externalUrl    String?
  errorMessage   String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  @@index([organizationId, providerKey, status])
  @@index([organizationId, jobId])
}

