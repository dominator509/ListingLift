generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OrganizationType {
  PLATFORM
  AGENCY
  SELLER
  CLIENT_WORKSPACE
}

enum ClientStatus {
  LEAD
  ACTIVE
  PAUSED
  ARCHIVED
}

enum RoleKey {
  SUPER_ADMIN
  OPERATOR
  AGENCY_ADMIN
  CLIENT_OWNER
  CLIENT_VIEWER
  FULFILLMENT_REVIEWER
  DESIGNER_EDITOR
  BILLING_MANAGER
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeadlineWarningLevel {
  NONE
  UPCOMING
  DUE_SOON
  OVERDUE
  BLOCKED
}

enum JobStatusEventType {
  CREATED
  STATUS_CHANGED
  MANUAL_OVERRIDE
  DEADLINE_CHANGED
  PRIORITY_CHANGED
  ADMIN_NOTE_ADDED
  CLIENT_NOTE_ADDED
}

enum JobStatus {
  DRAFT
  WAITING_FOR_UPLOAD
  UPLOAD_RECEIVED
  PROCESSING_QUEUED
  PROCESSING
  WAITING_FOR_REVIEW
  FLAGGED_OUTPUTS
  APPROVED
  REVISION_REQUESTED
  REPROCESSING
  READY_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  REFUNDED
  FAILED
  MANUAL_CONFIRMED
}

enum StripeCheckoutSessionStatus {
  DRAFT
  CREATED
  COMPLETED
  EXPIRED
  FAILED
  CANCELLED
}

enum StripeCheckoutPurpose {
  PACKAGE
  SUBSCRIPTION
  CREDITS
  RETAINER
  AGENCY
}

enum StripeWebhookProcessingStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  IGNORED
  FAILED
}

enum GumroadWebhookProcessingStatus {
  RECEIVED
  VERIFIED
  DUPLICATE
  MAPPED
  JOB_CREATED
  CREDITS_APPLIED
  UPLOAD_LINK_PLANNED
  IGNORED
  FAILED
  REFUNDED
}

enum GumroadFulfillmentKind {
  IMAGE_PACK_JOB
  CREDIT_PACK
  DIGITAL_DOWNLOAD
  DASHBOARD_ACCESS
  AGENCY_STARTER
}

enum FiverrDeliveryMode {
  FIVERR_ATTACHMENT
  FIVERR_MESSAGE_WITH_ALLOWED_LINK
  MANUAL_EXTERNAL_DELIVERY_RECORDED
}

enum FiverrWorkflowStatus {
  DRAFT
  ORDER_CAPTURED
  FILES_NEEDED
  FILES_RECEIVED
  PROCESSING
  WAITING_FOR_REVIEW
  FLAGGED
  APPROVED
  DELIVERY_READY
  DELIVERED_IN_FIVERR
  REVISION_REQUESTED
  REPROCESSING
  COMPLETED
  CANCELLED
  FAILED
}

enum FiverrRevisionStatus {
  NONE
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  READY_FOR_REVIEW
  DELIVERED
  CLOSED
}

enum FiverrWorkflowEventType {
  ORDER_CAPTURED
  PACKAGE_MAPPED
  UPLOAD_LINK_PLANNED
  FILES_RECEIVED
  DELIVERY_TEMPLATE_GENERATED
  DELIVERED_IN_FIVERR
  REVISION_STATUS_UPDATED
  MANUAL_OVERRIDE
  SAFETY_BLOCKED
}

enum UploadStatus {
  NOT_STARTED
  TOKEN_SENT
  PARTIAL
  COMPLETE
  FAILED
}

enum UploadSourceKind {
  DIRECT_UPLOAD
  ADMIN_UPLOAD
  ZIP_UPLOAD
  DRIVE_IMPORT
  DROPBOX_IMPORT
  SHOPIFY_EXPORT
  MANUAL_REPLACEMENT
}

enum UploadBatchStatus {
  PLANNED
  VALIDATING
  REJECTED
  ACCEPTED
  PARTIAL
  COMPLETE
  FAILED
}

enum FulfillmentStatus {
  NOT_STARTED
  IN_PROGRESS
  NEEDS_REVIEW
  APPROVED
  DELIVERED
  REVISION
  COMPLETE
  FAILED
}

enum ImageStatus {
  ORIGINAL_UPLOADED
  PROCESSING
  PROCESSED
  FLAGGED
  FAILED
  MANUAL_REPLACEMENT_UPLOADED
}

enum ProcessedFileStatus {
  CREATED
  PROCESSING
  READY_FOR_REVIEW
  FLAGGED
  APPROVED
  REJECTED
  REPLACED_MANUALLY
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  NOT_REQUIRED
}

enum ProcessingRunStatus {
  PLANNED
  QUEUED
  RUNNING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
  CANCELLED
}

enum ProcessingStepStatus {
  PLANNED
  SKIPPED
  RUNNING
  COMPLETED
  FAILED
  MANUAL_FALLBACK_REQUIRED
}

enum ProcessingOperation {
  METADATA_READ
  REMOVE_BACKGROUND
  TRANSPARENT_PNG
  WHITE_BACKGROUND
  WEBP
  RESIZE
  COMPRESS
  PRESET_OUTPUT
}

enum DeliveryLinkStatus {
  DRAFT
  ACTIVE
  EXPIRED
  REVOKED
}

enum DeliveryArchiveStatus {
  PLANNED
  GENERATING
  READY_FOR_REVIEW
  APPROVED
  FAILED
  REVOKED
}

enum DeliveryArchiveFileKind {
  OUTPUT
  MANIFEST
  README
  BEFORE_AFTER
  QUALITY_REPORT
  SOURCE_REFERENCE
}

enum DeliveryNotificationType {
  UPLOAD_RECEIVED
  PROCESSING_STARTED
  MANUAL_REVIEW_NEEDED
  JOB_COMPLETE
  REVISION_REQUESTED
  DOWNLOAD_READY
  CREDITS_LOW
  SUBSCRIPTION_RENEWAL
  FAILED_JOB_ALERT
  UPSELL_OPPORTUNITY_ALERT
  NEW_MARKETPLACE_ORDER_IMPORTED
  GUMROAD_PURCHASE_RECEIVED
  STRIPE_CHECKOUT_COMPLETED
  FIVERR_ORDER_MANUALLY_ADDED
  UPWORK_PROJECT_MANUALLY_ADDED
  TASKRABBIT_TASK_MANUALLY_ADDED
  DEADLINE_APPROACHING
}

enum DeliveryNotificationStatus {
  PLANNED
  QUEUED
  SENT
  FAILED
  SKIPPED
}

enum DeliveryDownloadEventType {
  TOKEN_RESOLVED
  DOWNLOAD_STARTED
  DOWNLOAD_COMPLETED
  DOWNLOAD_DENIED
  TOKEN_REVOKED
}

enum ManifestFileStatus {
  PLANNED
  INCLUDED
  MISSING
  FAILED
  MANUAL_REPLACEMENT
  EXCLUDED
}

enum PreviewGalleryStatus {
  DRAFT
  READY_FOR_REVIEW
  CLIENT_VISIBLE
  ARCHIVED
}

enum PreviewItemVisibility {
  ADMIN_ONLY
  CLIENT_VISIBLE
  HIDDEN
}

enum PreviewReviewStatus {
  READY_FOR_REVIEW
  APPROVED
  FLAGGED
  FAILED
  REJECTED
}

enum QualityReviewStatus {
  PENDING_REVIEW
  PASSED
  FLAGGED
  FAILED
  NEEDS_MANUAL_REPLACEMENT
  RESOLVED
  DISMISSED
}

enum QualityFlagSeverity {
  INFO
  WARNING
  BLOCKER
}

enum QualityFlagStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum QualityReviewEventType {
  REVIEW_CREATED
  FLAG_ADDED
  FLAG_ACKNOWLEDGED
  FLAG_RESOLVED
  FLAG_DISMISSED
  REVIEW_PASSED
  REVIEW_FAILED
  MANUAL_REPLACEMENT_REQUIRED
  REPROCESS_REQUESTED
  BULK_REVIEW
}

enum IntegrationMode {
  MOCK
  MANUAL
  API
  WEBHOOK
  EMAIL_PARSER
  CSV_IMPORT
}

enum ImageProviderConfigStatus {
  DRAFT
  ENABLED
  DISABLED
  HEALTHY
  DEGRADED
  FAILED
  NEEDS_SECRETS
}

enum ImageProviderHealthStatus {
  UNKNOWN
  HEALTHY
  DEGRADED
  FAILED
  BLOCKED
}

enum ChannelType {
  DIRECT
  PAYMENT
  MARKETPLACE
  FREELANCE
  SOCIAL
  ECOMMERCE
  LOCAL
  COMMUNITY
  MANUAL
}

enum OutputType {
  TRANSPARENT_PNG
  WHITE_JPG
  WEBP
  SQUARE_ECOMMERCE
  VERTICAL_SOCIAL
  HERO_IMAGE
  THUMBNAIL
  BEFORE_AFTER
  MANIFEST
  ZIP
  REPORT
  CUSTOM
}

enum OutputFormat {
  JPG
  PNG
  WEBP
  CSV
  TXT
  ZIP
  PDF
}

enum BackgroundType {
  WHITE
  TRANSPARENT
  BRAND_COLOR
  ORIGINAL
  SOFT_SHADOW
  CUSTOM
}

enum RevisionStatus {
  OPEN
  ACCEPTED
  IN_PROGRESS
  WAITING_FOR_CLIENT
  RESOLVED
  REJECTED
  CANCELLED
}

enum ReportType {
  DELIVERY_SUMMARY
  IMAGE_QUALITY
  LISTING_RECOMMENDATIONS
  MONTHLY_CLEANUP
  WHITE_LABEL
}

enum ReportStatus {
  DRAFT
  WAITING_FOR_APPROVAL
  APPROVED
  SENT
  ARCHIVED
}

enum WebhookEventStatus {
  RECEIVED
  VERIFIED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum UpsellStatus {
  DRAFT
  READY
  SENT
  ACCEPTED
  DECLINED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  PAUSED
  CANCELLED
  EXPIRED
}

enum TokenPurpose {
  UPLOAD
  DELIVERY
  REVISION_UPLOAD
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  name            String?
  passwordHash    String?
  accountStatus   AccountStatus @default(INVITED)
  lastLoginAt     DateTime?
  memberships     Membership[]
  sessions        Session[]
  assignedClients Client[]      @relation("AssignedAdmin")
  auditLogs       AuditLog[]    @relation("AuditActor")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  @@index([accountStatus])
  @@index([createdAt])
}

model Organization {
  id                                String                             @id @default(cuid())
  name                              String
  slug                              String                             @unique
  organizationType                  OrganizationType                   @default(SELLER)
  parentOrganizationId              String?
  parentOrganization                Organization?                      @relation("OrganizationHierarchy", fields: [parentOrganizationId], references: [id])
  childOrganizations                Organization[]                     @relation("OrganizationHierarchy")
  memberships                       Membership[]
  roles                             Role[]
  clients                           Client[]
  salesChannels                     SalesChannel[]
  externalOrders                    ExternalOrder[]
  jobs                              Job[]
  images                            Image[]
  processedFiles                    ProcessedFile[]
  packages                          Package[]
  platformPresets                   PlatformPreset[]
  creditLedgerEntries               CreditLedger[]
  subscriptions                     Subscription[]
  invoicePayments                   InvoicePayment[]
  manualInvoices                    ManualInvoice[]
  manualInvoicePayments             ManualInvoicePayment[]
  subscriptionEntitlements          SubscriptionEntitlement[]
  stripeCheckoutSessions            StripeCheckoutSession[]
  stripeWebhookEvents               StripeWebhookEvent[]
  gumroadProductMappings            GumroadProductMapping[]
  gumroadWebhookEvents              GumroadWebhookEvent[]
  fiverrGigMappings                 FiverrGigMapping[]
  fiverrDeliveryTemplates           FiverrDeliveryTemplate[]
  fiverrWorkflowEvents              FiverrWorkflowEvent[]
  genericSalesChannelMappings       GenericSalesChannelMapping[]
  genericSalesChannelWorkflowEvents GenericSalesChannelWorkflowEvent[]
  socialCommerceChannelMappings     SocialCommerceChannelMapping[]
  socialCommerceCreativePlans       SocialCommerceCreativePlan[]
  socialCommerceWorkflowEvents      SocialCommerceWorkflowEvent[]
  reports                           Report[]
  webhookEvents                     WebhookEvent[]
  upsellOffers                      UpsellOffer[]
  uploadTokens                      UploadToken[]
  uploadBatches                     UploadBatch[]
  uploadEvents                      UploadEvent[]
  sessions                          Session[]
  integrationConnections            IntegrationConnection[]
  imageProviderConfigurations       ImageProviderConfiguration[]
  imageProviderHealthChecks         ImageProviderHealthCheck[]
  imageProcessingRuns               ImageProcessingRun[]
  imageProcessingSteps              ImageProcessingStep[]
  imageProcessingErrors             ImageProcessingError[]
  deliveryArchives                  DeliveryArchive[]
  deliveryArchiveFiles              DeliveryArchiveFile[]
  deliveryDownloadEvents            DeliveryDownloadEvent[]
  deliveryNotificationLogs          DeliveryNotificationLog[]
  previewGalleries                  PreviewGallery[]
  previewGalleryItems               PreviewGalleryItem[]
  qualityReviews                    QualityReview[]
  qualityFlags                      QualityFlag[]
  qualityReviewEvents               QualityReviewEvent[]
  encryptedSecrets                  EncryptedSecret[]
  automationEvents                  AutomationEvent[]
  automationWebhookSubscriptions    AutomationWebhookSubscription[]
  automationWebhookDeliveries       AutomationWebhookDelivery[]
  automationDeadLetters             AutomationDeadLetter[]
  auditLogs                         AuditLog[]
  jobStatusEvents                   JobStatusEvent[]
  brandSetting                      BrandSetting?
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  deletedAt                         DateTime?
  revisionRequests                  RevisionRequest[]
  upworkOfferMappings               UpworkOfferMapping[]
  upworkProposalTemplates           UpworkProposalTemplate[]
  upworkWorkflowEvents              UpworkWorkflowEvent[]
  taskrabbitServiceMappings         TaskrabbitServiceMapping[]
  taskrabbitWorkflowEvents          TaskrabbitWorkflowEvent[]
  etsyListingPackMappings           EtsyListingPackMapping[]
  etsyListingImportRows             EtsyListingImportRow[]
  etsyWorkflowEvents                EtsyWorkflowEvent[]
  shopifyImagePackMappings          ShopifyImagePackMapping[]
  shopifyProductImportRows          ShopifyProductImportRow[]
  shopifyStoreConnections           ShopifyStoreConnection[]
  shopifyWorkflowEvents             ShopifyWorkflowEvent[]
  marketplaceExportMappings         MarketplaceExportMapping[]
  marketplaceExportWorkflowEvents   MarketplaceExportWorkflowEvent[]
  fileStorageConnections            FileStorageConnection[]
  externalFileReferences            ExternalFileReference[]
  fileStorageSyncEvents             FileStorageSyncEvent[]
  taskNotificationConnections       TaskNotificationConnection[]
  taskNotificationDeliveries        TaskNotificationDelivery[]
  taskDataExports                   TaskDataExport[]
  taskIntegrationTasks              TaskIntegrationTask[]
  advancedImageProcessingRecipes    AdvancedImageProcessingRecipe[]
  advancedImageProcessingRuns       AdvancedImageProcessingRun[]
  advancedImageProcessingReports    AdvancedImageProcessingReport[]

  @@index([organizationType])
  @@index([parentOrganizationId])
  @@index([createdAt])
}

model Membership {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  roleKey        RoleKey
  clientId       String?
  agencyScope    Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id])
  client         Client?      @relation(fields: [clientId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
  @@index([organizationId, roleKey])
  @@index([organizationId, clientId])
  @@index([clientId])
  @@index([userId])
  @@index([roleId])
}

model Session {
  id               String       @id @default(cuid())
  organizationId   String
  userId           String
  sessionTokenHash String       @unique
  active           Boolean      @default(true)
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  lastSeenAt       DateTime?
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([organizationId, userId])
  @@index([userId, active])
  @@index([expiresAt])
}

model Role {
  id             String           @id @default(cuid())
  organizationId String?
  key            RoleKey
  name           String
  description    String
  system         Boolean          @default(true)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    Membership[]
  permissions    RolePermission[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([key])
  @@index([organizationId, key])
}

model Permission {
  id          String           @id @default(cuid())
  key         String           @unique
  description String
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model Client {
  id                              String                           @id @default(cuid())
  organizationId                  String
  assignedAdminUserId             String?
  name                            String
  businessName                    String?
  storeUrl                        String?
  contactName                     String?
  email                           String?
  buyerType                       String?
  primarySalesChannel             String?
  sourceChannel                   String?
  subscriptionStatus              SubscriptionStatus?
  creditBalance                   Int                              @default(0)
  status                          ClientStatus                     @default(ACTIVE)
  organization                    Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedAdmin                   User?                            @relation("AssignedAdmin", fields: [assignedAdminUserId], references: [id])
  memberships                     Membership[]
  externalOrders                  ExternalOrder[]
  jobs                            Job[]
  images                          Image[]
  creditLedgerEntries             CreditLedger[]
  manualInvoicePayments           ManualInvoicePayment[]
  subscriptions                   Subscription[]
  invoicePayments                 InvoicePayment[]
  manualInvoices                  ManualInvoice[]
  subscriptionEntitlements        SubscriptionEntitlement[]
  stripeCheckoutSessions          StripeCheckoutSession[]
  gumroadWebhookEvents            GumroadWebhookEvent[]
  fiverrWorkflowEvents            FiverrWorkflowEvent[]
  revisionRequests                RevisionRequest[]
  reports                         Report[]
  upsellOffers                    UpsellOffer[]
  uploadTokens                    UploadToken[]
  uploadBatches                   UploadBatch[]
  uploadEvents                    UploadEvent[]
  createdAt                       DateTime                         @default(now())
  updatedAt                       DateTime                         @updatedAt
  deletedAt                       DateTime?
  upworkWorkflowEvents            UpworkWorkflowEvent[]
  taskrabbitWorkflowEvents        TaskrabbitWorkflowEvent[]
  etsyWorkflowEvents              EtsyWorkflowEvent[]
  shopifyWorkflowEvents           ShopifyWorkflowEvent[]
  socialCommerceWorkflowEvents    SocialCommerceWorkflowEvent[]
  marketplaceExportWorkflowEvents MarketplaceExportWorkflowEvent[]
  externalFileReferences          ExternalFileReference[]

  @@unique([organizationId, email])
  @@index([organizationId, status, createdAt])
  @@index([assignedAdminUserId])
}

model SalesChannel {
  id                        String            @id @default(cuid())
  organizationId            String
  key                       String
  name                      String
  channelType               ChannelType       @default(MANUAL)
  mode                      IntegrationMode   @default(MANUAL)
  canonicalKey              String?
  adapterKey                String?
  supportedModes            IntegrationMode[] @default([])
  enabled                   Boolean           @default(false)
  apiStatus                 String?
  notes                     String?
  packageMapping            Json?
  marketplaceSafetyRules    String[]          @default([])
  revenueAttributionEnabled Boolean           @default(true)
  manualFallbackEnabled     Boolean           @default(true)
  lastImportAt              DateTime?
  lastImportStatus          String?
  organization              Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalOrders            ExternalOrder[]
  jobs                      Job[]
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  deletedAt                 DateTime?

  @@unique([organizationId, key])
  @@index([organizationId, channelType, enabled])
  @@index([createdAt])
}

model ExternalOrder {
  id                                String                             @id @default(cuid())
  organizationId                    String
  salesChannelId                    String
  clientId                          String?
  externalOrderId                   String
  externalCustomerId                String?
  buyerName                         String?
  buyerEmailOrUsername              String?
  packageKey                        String?
  packagePurchasedRaw               String?
  orderAmountCents                  Int?
  orderAmountRaw                    String?
  currency                          String                             @default("USD")
  deadline                          DateTime?
  revisionAllowance                 Int                                @default(0)
  sourceUrl                         String?
  paymentStatus                     PaymentStatus                      @default(PENDING)
  uploadStatus                      UploadStatus                       @default(NOT_STARTED)
  fulfillmentStatus                 FulfillmentStatus                  @default(NOT_STARTED)
  channelName                       String?
  sourceFingerprint                 String?
  dedupeKey                         String?
  normalizationStatus               String                             @default("NORMALIZED")
  mappingStatus                     String                             @default("PENDING")
  normalizedPayload                 Json?
  revenueAttribution                Json?
  uploadLinkTriggeredAt             DateTime?
  importedAt                        DateTime?
  lastNormalizationError            String?
  rawPayload                        Json?
  organization                      Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesChannel                      SalesChannel                       @relation(fields: [salesChannelId], references: [id])
  client                            Client?                            @relation(fields: [clientId], references: [id])
  job                               Job?
  webhookEvents                     WebhookEvent[]
  gumroadWebhookEvents              GumroadWebhookEvent[]
  fiverrWorkflowEvents              FiverrWorkflowEvent[]
  genericSalesChannelWorkflowEvents GenericSalesChannelWorkflowEvent[]
  socialCommerceChannelMappings     SocialCommerceChannelMapping[]
  socialCommerceCreativePlans       SocialCommerceCreativePlan[]
  socialCommerceWorkflowEvents      SocialCommerceWorkflowEvent[]
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  upworkWorkflowEvents              UpworkWorkflowEvent[]
  taskrabbitWorkflowEvents          TaskrabbitWorkflowEvent[]
  etsyWorkflowEvents                EtsyWorkflowEvent[]
  shopifyWorkflowEvents             ShopifyWorkflowEvent[]
  marketplaceExportWorkflowEvents   MarketplaceExportWorkflowEvent[]

  @@unique([salesChannelId, externalOrderId])
  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
  @@index([organizationId, paymentStatus, fulfillmentStatus])
  @@index([organizationId, channelName, importedAt])
  @@index([organizationId, normalizationStatus, mappingStatus])
  @@index([clientId])
}

model Job {
  id                                String                             @id @default(cuid())
  organizationId                    String
  clientId                          String?
  salesChannelId                    String?
  externalOrderId                   String?                            @unique
  packageId                         String?
  jobNumber                         String?
  status                            JobStatus                          @default(DRAFT)
  priority                          JobPriority                        @default(NORMAL)
  queuePosition                     Int?
  deadlineWarningLevel              DeadlineWarningLevel               @default(NONE)
  paymentStatus                     PaymentStatus                      @default(PENDING)
  uploadStatus                      UploadStatus                       @default(NOT_STARTED)
  fulfillmentStatus                 FulfillmentStatus                  @default(NOT_STARTED)
  title                             String
  targetPlatform                    String?
  productCategory                   String?
  imageQuantity                     Int                                @default(0)
  backgroundPreference              String?
  outputSize                        String?
  fileFormat                        String?
  brandColors                       String?
  skuNamingPreference               String?
  revisionNotes                     String?
  deadline                          DateTime?
  adminNotes                        String?
  clientVisibleNotes                String?
  operatorNotes                     String?
  clientIntakeNotes                 String?
  adminQualityNotes                 String?
  deliveryNotes                     String?
  approvedAt                        DateTime?
  approvedByUserId                  String?
  deliveredAt                       DateTime?
  completedAt                       DateTime?
  cancelledAt                       DateTime?
  failedReason                      String?
  manuallyCreatedByUserId           String?
  queuedAt                          DateTime?
  lastStatusChangedAt               DateTime?
  lastStatusChangedByUserId         String?
  selectedPresetKeys                String[]                           @default([])
  statusHistory                     Json?
  sourceUrl                         String?
  sourceChannelName                 String?
  revenueAttribution                Json?
  organization                      Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                            Client?                            @relation(fields: [clientId], references: [id])
  salesChannel                      SalesChannel?                      @relation(fields: [salesChannelId], references: [id])
  externalOrder                     ExternalOrder?                     @relation(fields: [externalOrderId], references: [id])
  package                           Package?                           @relation(fields: [packageId], references: [id])
  images                            Image[]
  processedFiles                    ProcessedFile[]
  revisions                         RevisionRequest[]
  reports                           Report[]
  deliveryLinks                     DeliveryLink[]
  deliveryArchives                  DeliveryArchive[]
  deliveryArchiveFiles              DeliveryArchiveFile[]
  deliveryDownloadEvents            DeliveryDownloadEvent[]
  deliveryNotificationLogs          DeliveryNotificationLog[]
  previewGalleries                  PreviewGallery[]
  previewGalleryItems               PreviewGalleryItem[]
  qualityReviews                    QualityReview[]
  qualityFlags                      QualityFlag[]
  qualityReviewEvents               QualityReviewEvent[]
  uploadTokens                      UploadToken[]
  upsellOffers                      UpsellOffer[]
  webhookEvents                     WebhookEvent[]
  automationWebhookDeliveries       AutomationWebhookDelivery[]
  creditLedgerEntries               CreditLedger[]
  stripeCheckoutSessions            StripeCheckoutSession[]
  gumroadWebhookEvents              GumroadWebhookEvent[]
  fiverrWorkflowEvents              FiverrWorkflowEvent[]
  genericSalesChannelWorkflowEvents GenericSalesChannelWorkflowEvent[]
  socialCommerceChannelMappings     SocialCommerceChannelMapping[]
  socialCommerceCreativePlans       SocialCommerceCreativePlan[]
  socialCommerceWorkflowEvents      SocialCommerceWorkflowEvent[]
  auditLogs                         AuditLog[]
  statusEvents                      JobStatusEvent[]
  imageProcessingRuns               ImageProcessingRun[]
  imageProcessingSteps              ImageProcessingStep[]
  imageProcessingErrors             ImageProcessingError[]
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  deletedAt                         DateTime?
  uploadBatches                     UploadBatch[]
  uploadEvents                      UploadEvent[]
  upworkWorkflowEvents              UpworkWorkflowEvent[]
  taskrabbitWorkflowEvents          TaskrabbitWorkflowEvent[]
  etsyListingImportRows             EtsyListingImportRow[]
  etsyWorkflowEvents                EtsyWorkflowEvent[]
  shopifyProductImportRows          ShopifyProductImportRow[]
  shopifyWorkflowEvents             ShopifyWorkflowEvent[]
  marketplaceExportWorkflowEvents   MarketplaceExportWorkflowEvent[]
  externalFileReferences            ExternalFileReference[]
  fileStorageSyncEvents             FileStorageSyncEvent[]
  taskNotificationDeliveries        TaskNotificationDelivery[]
  taskIntegrationTasks              TaskIntegrationTask[]
  advancedImageProcessingRuns       AdvancedImageProcessingRun[]
  advancedImageProcessingReports    AdvancedImageProcessingReport[]

  @@unique([organizationId, jobNumber])
  @@index([organizationId, status, deadline])
  @@index([organizationId, priority, deadline])
  @@index([organizationId, deadlineWarningLevel])
  @@index([organizationId, createdAt])
  @@index([clientId, createdAt])
  @@index([salesChannelId])
  @@index([packageId])
}

model JobStatusEvent {
  id             String             @id @default(cuid())
  organizationId String
  jobId          String
  actorUserId    String?
  type           JobStatusEventType
  fromStatus     JobStatus?
  toStatus       JobStatus?
  note           String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([organizationId, jobId, createdAt])
  @@index([jobId, createdAt])
}

model Image {
  id                    String                 @id @default(cuid())
  organizationId        String
  clientId              String?
  jobId                 String
  uploadBatchId         String?
  uploadTokenId         String?
  sourceKind            UploadSourceKind       @default(DIRECT_UPLOAD)
  originalName          String
  originalRelativePath  String?
  storageKey            String
  originalFileUrl       String?
  mimeType              String
  fileExtension         String?
  sizeBytes             Int
  width                 Int?
  height                Int?
  sha256                String?
  uploadStatus          UploadStatus           @default(COMPLETE)
  validationStatus      String                 @default("ACCEPTED")
  status                ImageStatus            @default(ORIGINAL_UPLOADED)
  qualityFlags          String[]
  metadata              Json?
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client?                @relation(fields: [clientId], references: [id])
  job                   Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  uploadBatch           UploadBatch?           @relation(fields: [uploadBatchId], references: [id])
  uploadToken           UploadToken?           @relation(fields: [uploadTokenId], references: [id])
  uploadEvents          UploadEvent[]
  processedFiles        ProcessedFile[]
  previewGalleryItems   PreviewGalleryItem[]
  qualityReviews        QualityReview[]
  qualityFlagRecords    QualityFlag[]
  revisions             RevisionRequest[]
  imageProcessingRuns   ImageProcessingRun[]
  imageProcessingSteps  ImageProcessingStep[]
  imageProcessingErrors ImageProcessingError[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([jobId, storageKey])
  @@index([organizationId, createdAt])
  @@index([jobId, status])
  @@index([jobId, uploadStatus])
  @@index([uploadBatchId])
  @@index([uploadTokenId])
  @@index([clientId])
}

model ProcessedFile {
  id                   String                @id @default(cuid())
  organizationId       String
  jobId                String
  imageId              String?
  presetKey            String?
  outputType           OutputType
  outputFormat         OutputFormat
  backgroundType       BackgroundType?
  fileName             String
  folderPath           String
  storageKey           String
  outputFileUrl        String?
  mimeType             String
  width                Int?
  height               Int?
  sizeBytes            Int?
  qualityScore         Int?
  status               ProcessedFileStatus   @default(CREATED)
  approvedStatus       ApprovalStatus        @default(PENDING)
  approvedAt           DateTime?
  rejectedReason       String?
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  image                Image?                @relation(fields: [imageId], references: [id])
  deliveryArchiveFiles DeliveryArchiveFile[]
  previewGalleryItems  PreviewGalleryItem[]
  qualityReviews       QualityReview[]
  qualityFlags         QualityFlag[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([jobId, storageKey])
  @@index([organizationId, createdAt])
  @@index([jobId, presetKey])
  @@index([jobId, status, approvedStatus])
  @@index([imageId])
}

model ImageProcessingRun {
  id                     String                 @id @default(cuid())
  organizationId         String
  jobId                  String
  providerKey            String
  status                 ProcessingRunStatus    @default(PLANNED)
  totalImages            Int                    @default(0)
  totalRequestedOutputs  Int                    @default(0)
  totalCreatedOutputs    Int                    @default(0)
  totalFailedOutputs     Int                    @default(0)
  manualFallbackRequired Boolean                @default(false)
  selectedPresetKeys     String[]               @default([])
  operations             String[]               @default([])
  metadata               Json?
  startedAt              DateTime?
  finishedAt             DateTime?
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                    Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  steps                  ImageProcessingStep[]
  errors                 ImageProcessingError[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  image                  Image?                 @relation(fields: [imageId], references: [id])
  imageId                String?

  @@index([organizationId, status, createdAt])
  @@index([jobId, status])
  @@index([providerKey, status])
}

model ImageProcessingStep {
  id               String               @id @default(cuid())
  organizationId   String
  jobId            String
  runId            String?
  imageId          String?
  providerKey      String
  operation        ProcessingOperation
  status           ProcessingStepStatus @default(PLANNED)
  inputStorageKey  String
  outputStorageKey String?
  presetKey        String?
  outputType       OutputType?
  outputFormat     OutputFormat?
  backgroundType   BackgroundType?
  attempt          Int                  @default(1)
  durationMs       Int?
  errorCode        String?
  errorMessage     String?
  metadata         Json?
  startedAt        DateTime?
  completedAt      DateTime?
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job              Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  run              ImageProcessingRun?  @relation(fields: [runId], references: [id], onDelete: Cascade)
  image            Image?               @relation(fields: [imageId], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([organizationId, jobId, status])
  @@index([runId, status])
  @@index([imageId, status])
  @@index([providerKey, operation])
}

model ImageProcessingError {
  id                     String              @id @default(cuid())
  organizationId         String
  jobId                  String
  runId                  String?
  imageId                String?
  providerKey            String?
  code                   String
  message                String
  retryable              Boolean             @default(false)
  manualFallbackRequired Boolean             @default(true)
  safeDetails            Json?
  metadata               Json?
  resolvedAt             DateTime?
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                    Job                 @relation(fields: [jobId], references: [id], onDelete: Cascade)
  run                    ImageProcessingRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  image                  Image?              @relation(fields: [imageId], references: [id])
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([organizationId, jobId, createdAt])
  @@index([runId])
  @@index([imageId])
  @@index([providerKey, code])
  @@index([manualFallbackRequired, resolvedAt])
}

model Package {
  id                      String        @id @default(cuid())
  organizationId          String?
  key                     String        @unique
  publicSlug              String?       @unique
  name                    String
  shortName               String?
  category                String        @default("custom")
  description             String
  positioning             String?
  imageMin                Int?
  imageMax                Int?
  imageAllowance          Int?
  priceMinCents           Int?
  priceMaxCents           Int?
  currency                String        @default("USD")
  billingInterval         String?
  checkoutMode            String        @default("manual_quote")
  deliveryWindowDays      Int?
  revisionAllowance       Int           @default(0)
  includedOutputTypes     String[]
  defaultSalesChannelKeys String[]
  features                String[]
  recommendedFor          String[]
  deliverables            String[]
  pricePolicy             Json?
  safeClaim               String        @default("Formatted as platform-ready drafts. Seller review recommended before publishing.")
  upsellPackageKeys       String[]
  popular                 Boolean       @default(false)
  sortOrder               Int           @default(0)
  active                  Boolean       @default(true)
  manualReviewRequired    Boolean       @default(false)
  organization            Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobs                    Job[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt
  deletedAt               DateTime?

  @@index([organizationId, active, sortOrder])
  @@index([category, active])
}

model PlatformPreset {
  id                      String          @id @default(cuid())
  organizationId          String?
  key                     String          @unique
  platform                String
  platformKey             String          @default("custom")
  name                    String
  description             String?
  width                   Int
  height                  Int
  aspectRatio             String?
  orientation             String          @default("custom")
  format                  OutputFormat
  folderPath              String
  folderDestination       Json?
  background              BackgroundType?
  compressionTargetKb     Int?
  maxFileSizeKb           Int?
  safeMarginPercent       Float           @default(5)
  namingConvention        String?
  recommendedUse          String?
  qualityChecks           String[]        @default([])
  channelTags             String[]        @default([])
  safeLanguage            String          @default("platform-ready draft; seller-review recommended")
  marketplaceSafeClaim    String          @default("Formatted for common marketplace use. Review against current platform guidelines before publishing.")
  sellerReviewRequired    Boolean         @default(true)
  supportsTransparent     Boolean         @default(false)
  supportsWhiteBackground Boolean         @default(false)
  editable                Boolean         @default(true)
  system                  Boolean         @default(true)
  sortOrder               Int             @default(100)
  active                  Boolean         @default(true)
  organization            Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime?

  @@index([organizationId, platform, active])
  @@index([platformKey, active])
  @@index([sortOrder])
}

model CreditLedger {
  id                  String                @id @default(cuid())
  organizationId      String
  clientId            String?
  jobId               String?
  invoicePaymentId    String?
  amount              Int
  balanceAfter        Int?
  creditType          String                @default("manual")
  entryType           CreditLedgerEntryType @default(MANUAL_ADJUSTMENT)
  source              String                @default("manual")
  sourceReferenceType String?
  sourceReferenceId   String?
  reason              String
  notes               String?
  createdByUserId     String?
  expiresAt           DateTime?
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client?               @relation(fields: [clientId], references: [id])
  job                 Job?                  @relation(fields: [jobId], references: [id])
  invoicePayment      InvoicePayment?       @relation(fields: [invoicePaymentId], references: [id])
  createdAt           DateTime              @default(now())

  @@index([organizationId, createdAt])
  @@index([clientId, createdAt])
  @@index([jobId])
}

model Subscription {
  id                    String                    @id @default(cuid())
  organizationId        String
  clientId              String?
  provider              String
  externalId            String?
  stripeCustomerId      String?
  stripeSubscriptionId  String?
  status                SubscriptionStatus        @default(ACTIVE)
  planKey               String
  planName              String?
  monthlyImageAllowance Int?
  entitlements          SubscriptionEntitlement[]
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  cancelAt              DateTime?
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client?                   @relation(fields: [clientId], references: [id])
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([provider, externalId])
  @@index([organizationId, status])
  @@index([clientId])
}

model InvoicePayment {
  id                    String                 @id @default(cuid())
  organizationId        String
  clientId              String?
  provider              String
  externalId            String?
  amountCents           Int
  currency              String                 @default("USD")
  status                PaymentStatus          @default(PENDING)
  paidAt                DateTime?
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client?                @relation(fields: [clientId], references: [id])
  creditLedgerEntries   CreditLedger[]
  manualInvoicePayments ManualInvoicePayment[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([provider, externalId])
  @@index([organizationId, status, createdAt])
  @@index([clientId])
}

model RevisionRequest {
  id             String         @id @default(cuid())
  organizationId String
  jobId          String
  clientId       String?
  imageId        String?
  requestText    String
  adminNotes     String?
  status         RevisionStatus @default(OPEN)
  resolvedAt     DateTime?
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id])
  image          Image?         @relation(fields: [imageId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([jobId, status])
  @@index([clientId])
}

model Report {
  id              String       @id @default(cuid())
  organizationId  String
  jobId           String?
  clientId        String?
  type            ReportType   @default(DELIVERY_SUMMARY)
  status          ReportStatus @default(DRAFT)
  title           String
  body            String
  pdfUrl          String?
  approvedByAdmin Boolean      @default(false)
  approvedAt      DateTime?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job             Job?         @relation(fields: [jobId], references: [id])
  client          Client?      @relation(fields: [clientId], references: [id])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId, type, status])
  @@index([jobId])
  @@index([clientId])
}

model WebhookEvent {
  id                String             @id @default(cuid())
  organizationId    String?
  externalOrderId   String?
  jobId             String?
  provider          String
  eventType         String
  externalId        String?
  status            WebhookEventStatus @default(RECEIVED)
  signatureVerified Boolean            @default(false)
  payload           Json
  processedAt       DateTime?
  error             String?
  organization      Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  externalOrder     ExternalOrder?     @relation(fields: [externalOrderId], references: [id])
  job               Job?               @relation(fields: [jobId], references: [id])
  createdAt         DateTime           @default(now())

  @@unique([provider, externalId])
  @@index([provider, eventType])
  @@index([organizationId, status, createdAt])
}

model UpsellOffer {
  id                  String       @id @default(cuid())
  organizationId      String
  clientId            String?
  jobId               String?
  offerType           String
  title               String
  body                String
  cta                 String
  suggestedPriceCents Int?
  currency            String       @default("USD")
  status              UpsellStatus @default(DRAFT)
  sentAt              DateTime?
  acceptedAt          DateTime?
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client              Client?      @relation(fields: [clientId], references: [id])
  job                 Job?         @relation(fields: [jobId], references: [id])
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([clientId])
  @@index([jobId])
}

model UploadToken {
  id               String        @id @default(cuid())
  organizationId   String
  clientId         String?
  jobId            String?
  tokenHash        String        @unique
  purpose          TokenPurpose  @default(UPLOAD)
  expiresAt        DateTime
  usedAt           DateTime?
  revokedAt        DateTime?
  maxFiles         Int?
  maxBytesPerFile  Int?
  allowedMimeTypes String[]      @default([])
  metadata         Json?
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client           Client?       @relation(fields: [clientId], references: [id])
  job              Job?          @relation(fields: [jobId], references: [id])
  uploadBatches    UploadBatch[]
  images           Image[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([organizationId, expiresAt])
  @@index([clientId])
  @@index([jobId])
}

model UploadBatch {
  id                String            @id @default(cuid())
  organizationId    String
  clientId          String?
  jobId             String?
  uploadTokenId     String?
  sourceKind        UploadSourceKind  @default(DIRECT_UPLOAD)
  status            UploadBatchStatus @default(PLANNED)
  fileCount         Int               @default(0)
  acceptedFileCount Int               @default(0)
  rejectedFileCount Int               @default(0)
  totalBytes        BigInt            @default(0)
  clientNotes       String?
  adminNotes        String?
  metadata          Json?
  completedAt       DateTime?
  failedReason      String?
  organization      Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client            Client?           @relation(fields: [clientId], references: [id])
  job               Job?              @relation(fields: [jobId], references: [id])
  uploadToken       UploadToken?      @relation(fields: [uploadTokenId], references: [id])
  images            Image[]
  events            UploadEvent[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([jobId, status])
  @@index([clientId])
  @@index([uploadTokenId])
}

model UploadEvent {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  jobId          String?
  uploadBatchId  String?
  imageId        String?
  eventType      String
  severity       String       @default("INFO")
  message        String
  metadata       Json?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id])
  job            Job?         @relation(fields: [jobId], references: [id])
  uploadBatch    UploadBatch? @relation(fields: [uploadBatchId], references: [id])
  image          Image?       @relation(fields: [imageId], references: [id])
  createdAt      DateTime     @default(now())

  @@index([organizationId, eventType, createdAt])
  @@index([jobId, createdAt])
  @@index([uploadBatchId])
  @@index([imageId])
}

model DeliveryLink {
  id                         String             @id @default(cuid())
  jobId                      String
  tokenHash                  String             @unique
  status                     DeliveryLinkStatus @default(DRAFT)
  expiresAt                  DateTime
  approvedOnly               Boolean            @default(true)
  downloadedAt               DateTime?
  revokedAt                  DateTime?
  maxDownloads               Int                @default(5)
  downloadCount              Int                @default(0)
  recipientEmailHash         String?
  sentAt                     DateTime?
  sentByUserId               String?
  deliveryNotes              String?
  marketplaceDeliveryMessage String?
  job                        Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@index([jobId, status])
  @@index([expiresAt])
  @@index([sentAt])
}

model DeliveryDownloadEvent {
  id             String                    @id @default(cuid())
  organizationId String
  jobId          String?
  clientId       String?
  deliveryLinkId String?
  tokenHash      String
  type           DeliveryDownloadEventType
  allowed        Boolean                   @default(false)
  denialReason   String?
  requestIpHash  String?
  userAgent      String?
  metadata       Json?
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job?                      @relation(fields: [jobId], references: [id])
  createdAt      DateTime                  @default(now())

  @@index([organizationId, type, createdAt])
  @@index([jobId, createdAt])
  @@index([deliveryLinkId])
  @@index([tokenHash])
}

model DeliveryNotificationLog {
  id                String                     @id @default(cuid())
  organizationId    String
  jobId             String?
  clientId          String?
  type              DeliveryNotificationType
  status            DeliveryNotificationStatus @default(PLANNED)
  providerKey       String
  recipientRedacted String
  subject           String
  bodyPreview       String?
  providerMessageId String?
  errorMessage      String?
  metadata          Json?
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job               Job?                       @relation(fields: [jobId], references: [id])
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([organizationId, type, status])
  @@index([jobId, createdAt])
  @@index([status])
}

model DeliveryArchive {
  id                   String                @id @default(cuid())
  organizationId       String
  jobId                String
  status               DeliveryArchiveStatus @default(PLANNED)
  rootFolder           String
  zipFileName          String
  zipStorageKey        String
  manifestStorageKey   String?
  readmeStorageKey     String?
  fileCount            Int                   @default(0)
  outputCount          Int                   @default(0)
  missingCount         Int                   @default(0)
  sellerReviewRequired Boolean               @default(true)
  approvedOnly         Boolean               @default(true)
  generatedByUserId    String?
  approvedAt           DateTime?
  approvedByUserId     String?
  failedReason         String?
  metadata             Json?
  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  files                DeliveryArchiveFile[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([jobId, zipStorageKey])
  @@index([organizationId, status, createdAt])
  @@index([jobId, status])
  @@index([approvedOnly, status])
}

model DeliveryArchiveFile {
  id                   String                  @id @default(cuid())
  organizationId       String
  jobId                String
  archiveId            String?
  processedFileId      String?
  sourceImageId        String?
  kind                 DeliveryArchiveFileKind
  archivePath          String
  folderPath           String
  fileName             String
  storageKey           String?
  mimeType             String
  format               OutputFormat
  status               ManifestFileStatus      @default(PLANNED)
  sellerReviewRequired Boolean                 @default(true)
  metadata             Json?
  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job                     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  archive              DeliveryArchive?        @relation(fields: [archiveId], references: [id], onDelete: Cascade)
  processedFile        ProcessedFile?          @relation(fields: [processedFileId], references: [id])
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([jobId, archivePath])
  @@index([organizationId, jobId, kind])
  @@index([archiveId, kind])
  @@index([processedFileId])
  @@index([status])
}

model PreviewGallery {
  id                   String               @id @default(cuid())
  organizationId       String
  jobId                String
  galleryKey           String
  status               PreviewGalleryStatus @default(DRAFT)
  clientPreviewEnabled Boolean              @default(false)
  approvedOnly         Boolean              @default(true)
  itemCount            Int                  @default(0)
  approvedItemCount    Int                  @default(0)
  flaggedItemCount     Int                  @default(0)
  failedItemCount      Int                  @default(0)
  beforeAfterPairCount Int                  @default(0)
  generatedByUserId    String?
  metadata             Json?
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  items                PreviewGalleryItem[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([jobId, galleryKey])
  @@index([organizationId, status, createdAt])
  @@index([jobId, status])
  @@index([clientPreviewEnabled, status])
}

model PreviewGalleryItem {
  id                  String                @id @default(cuid())
  organizationId      String
  jobId               String
  galleryId           String
  itemKey             String
  imageId             String?
  processedFileId     String?
  originalName        String?
  outputFileName      String
  originalStorageKey  String?
  previewStorageKey   String?
  thumbnailStorageKey String?
  outputType          OutputType?
  outputFormat        OutputFormat?
  presetKey           String?
  platform            String?
  visibility          PreviewItemVisibility @default(ADMIN_ONLY)
  reviewStatus        PreviewReviewStatus   @default(READY_FOR_REVIEW)
  approvedStatus      ApprovalStatus        @default(PENDING)
  qualityScore        Int?
  flags               String[]              @default([])
  sortOrder           Int                   @default(0)
  adminNotes          String?
  clientNotes         String?
  metadata            Json?
  organization        Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                 Job                   @relation(fields: [jobId], references: [id], onDelete: Cascade)
  gallery             PreviewGallery        @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  image               Image?                @relation(fields: [imageId], references: [id])
  processedFile       ProcessedFile?        @relation(fields: [processedFileId], references: [id])
  qualityReviews      QualityReview[]
  qualityFlagRecords  QualityFlag[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([galleryId, itemKey])
  @@index([organizationId, jobId, reviewStatus])
  @@index([jobId, visibility, approvedStatus])
  @@index([imageId])
  @@index([processedFileId])
  @@index([presetKey])
}

model IntegrationConnection {
  id                          String                       @id @default(cuid())
  organizationId              String
  providerKey                 String
  mode                        IntegrationMode              @default(MOCK)
  enabled                     Boolean                      @default(false)
  config                      Json?
  healthStatus                String?
  lastCheckedAt               DateTime?
  organization                Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  imageProviderConfigurations ImageProviderConfiguration[]
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt

  @@unique([organizationId, providerKey])
  @@index([organizationId, enabled])
}

model ImageProviderConfiguration {
  id                    String                     @id @default(cuid())
  organizationId        String
  providerKey           String
  connectionId          String?
  enabled               Boolean                    @default(false)
  mode                  IntegrationMode            @default(MOCK)
  status                ImageProviderConfigStatus  @default(DRAFT)
  priority              Int                        @default(100)
  capabilities          String[]                   @default([])
  config                Json?
  secretStatus          Json?
  healthStatus          ImageProviderHealthStatus  @default(UNKNOWN)
  healthMessage         String?
  lastHealthCheckedAt   DateTime?
  manualFallbackEnabled Boolean                    @default(true)
  organization          Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection            IntegrationConnection?     @relation(fields: [connectionId], references: [id])
  healthChecks          ImageProviderHealthCheck[]
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  deletedAt             DateTime?

  @@unique([organizationId, providerKey])
  @@index([organizationId, enabled, priority])
  @@index([providerKey, status])
}

model ImageProviderHealthCheck {
  id              String                      @id @default(cuid())
  organizationId  String
  providerKey     String
  configurationId String?
  status          ImageProviderHealthStatus   @default(UNKNOWN)
  message         String
  safeDetails     Json?
  checkedAt       DateTime                    @default(now())
  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuration   ImageProviderConfiguration? @relation(fields: [configurationId], references: [id])

  @@index([organizationId, providerKey, checkedAt])
  @@index([configurationId, checkedAt])
}

model EncryptedSecret {
  id                             String                          @id @default(cuid())
  organizationId                 String
  providerKey                    String
  name                           String
  ciphertext                     String
  keyVersion                     String?
  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  fileStorageConnections         FileStorageConnection[]
  automationWebhookSubscriptions AutomationWebhookSubscription[]
  taskNotificationConnections    TaskNotificationConnection[]

  @@unique([organizationId, providerKey, name])
  @@index([providerKey])
}

model AutomationEvent {
  id             String       @id @default(cuid())
  organizationId String
  provider       String
  eventType      String
  payload        Json
  status         String       @default("queued")
  error          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([provider, eventType])
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  actorUserId    String?
  jobId          String?
  action         String
  targetType     String
  targetId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id])
  job            Job?          @relation(fields: [jobId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([organizationId, action, createdAt])
  @@index([actorUserId])
  @@index([jobId])
}

model BrandSetting {
  id                      String       @id @default(cuid())
  organizationId          String       @unique
  logoUrl                 String?
  primaryColor            String?
  secondaryColor          String?
  deliveryFooter          String?
  portalName              String?
  customDomain            String?
  supportEmail            String?
  hideListingLiftBranding Boolean      @default(false)
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt
}

model QualityReview {
  id                        String               @id @default(cuid())
  organizationId            String
  jobId                     String
  imageId                   String?
  processedFileId           String?
  previewGalleryItemId      String?
  reviewKey                 String
  status                    QualityReviewStatus  @default(PENDING_REVIEW)
  score                     Int?
  severity                  QualityFlagSeverity?
  checklist                 Json?
  blockerCount              Int                  @default(0)
  warningCount              Int                  @default(0)
  infoCount                 Int                  @default(0)
  adminNotes                String?
  clientVisibleNotes        String?
  reviewedByUserId          String?
  reviewedAt                DateTime?
  resolvedAt                DateTime?
  manualFallbackRequired    Boolean              @default(false)
  manualReplacementRequired Boolean              @default(false)
  finalDeliveryBlocked      Boolean              @default(true)
  metadata                  Json?
  organization              Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                       Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  image                     Image?               @relation(fields: [imageId], references: [id])
  processedFile             ProcessedFile?       @relation(fields: [processedFileId], references: [id])
  previewGalleryItem        PreviewGalleryItem?  @relation(fields: [previewGalleryItemId], references: [id])
  flags                     QualityFlag[]
  events                    QualityReviewEvent[]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@unique([jobId, reviewKey])
  @@index([organizationId, jobId, status])
  @@index([organizationId, finalDeliveryBlocked])
  @@index([jobId, status])
  @@index([processedFileId])
  @@index([previewGalleryItemId])
}

model QualityFlag {
  id                   String               @id @default(cuid())
  organizationId       String
  jobId                String
  reviewId             String?
  imageId              String?
  processedFileId      String?
  previewGalleryItemId String?
  flagKey              String
  category             String
  severity             QualityFlagSeverity  @default(WARNING)
  status               QualityFlagStatus    @default(OPEN)
  blocksDelivery       Boolean              @default(true)
  message              String
  suggestedAction      String?
  adminNotes           String?
  clientVisible        Boolean              @default(false)
  createdByUserId      String?
  resolvedByUserId     String?
  resolvedAt           DateTime?
  resolution           String?
  metadata             Json?
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job                  Job                  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  review               QualityReview?       @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  image                Image?               @relation(fields: [imageId], references: [id])
  processedFile        ProcessedFile?       @relation(fields: [processedFileId], references: [id])
  previewGalleryItem   PreviewGalleryItem?  @relation(fields: [previewGalleryItemId], references: [id])
  events               QualityReviewEvent[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([organizationId, jobId, status])
  @@index([organizationId, severity, status])
  @@index([jobId, blocksDelivery])
  @@index([reviewId])
  @@index([processedFileId])
  @@index([previewGalleryItemId])
  @@index([flagKey])
}

model QualityReviewEvent {
  id             String                 @id @default(cuid())
  organizationId String
  jobId          String
  reviewId       String?
  flagId         String?
  actorUserId    String?
  type           QualityReviewEventType
  message        String?
  metadata       Json?
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  review         QualityReview?         @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  flag           QualityFlag?           @relation(fields: [flagId], references: [id], onDelete: Cascade)
  createdAt      DateTime               @default(now())

  @@index([organizationId, jobId, createdAt])
  @@index([reviewId, createdAt])
  @@index([flagId, createdAt])
}

enum ManualApprovalGateStatus {
  WAITING_FOR_QC
  READY_FOR_ADMIN_REVIEW
  BLOCKED_BY_FLAGS
  BLOCKED_BY_REVISIONS
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

enum ManualApprovalEventType {
  READINESS_CHECKED
  OUTPUT_APPROVED
  OUTPUT_REJECTED
  JOB_APPROVED
  JOB_REJECTED
  REVISION_REQUESTED
  MANUAL_REPLACEMENT_MARKED
  DELIVERY_GATE_CHECKED
}

enum RevisionWorkflowEventTypeV2 {
  REQUESTED
  ACCEPTED
  REJECTED
  STARTED
  COMMENT_ADDED
  MANUAL_REPLACEMENT_UPLOADED
  REPROCESSING_REQUESTED
  RESOLVED
  CANCELLED
}

model ManualApprovalGate {
  id                             String                   @id @default(cuid())
  organizationId                 String
  jobId                          String                   @unique
  status                         ManualApprovalGateStatus @default(WAITING_FOR_QC)
  outputCount                    Int                      @default(0)
  approvedOutputCount            Int                      @default(0)
  rejectedOutputCount            Int                      @default(0)
  unresolvedBlockingFlags        Int                      @default(0)
  openRevisionCount              Int                      @default(0)
  manualReplacementRequiredCount Int                      @default(0)
  finalDeliveryAllowed           Boolean                  @default(false)
  checkedByUserId                String?
  checkedAt                      DateTime?
  approvedByUserId               String?
  approvedAt                     DateTime?
  notes                          String?
  metadata                       Json?
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, finalDeliveryAllowed])
  @@index([jobId])
}

model ManualApprovalEvent {
  id              String                  @id @default(cuid())
  organizationId  String
  jobId           String
  processedFileId String?
  revisionId      String?
  actorUserId     String?
  type            ManualApprovalEventType
  fromStatus      String?
  toStatus        String?
  decision        String?
  blocksDelivery  Boolean                 @default(true)
  message         String?
