  active              Boolean            @default(true)
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@unique([organizationId, templateKey])
  @@index([organizationId, active])
}

model FiverrWorkflowEvent {
  id                    String                  @id @default(cuid())
  organizationId        String
  clientId              String?
  externalOrderId       String?
  jobId                 String?
  fiverrOrderId         String
  dedupeKey             String
  workflowStatus        FiverrWorkflowStatus    @default(DRAFT)
  eventType             FiverrWorkflowEventType
  revisionStatus        FiverrRevisionStatus    @default(NONE)
  buyerUsernameRedacted String?
  gigTitle              String?
  packageKey            String?
  amountCents           Int?
  currency              String                  @default("USD")
  deliveryMode          FiverrDeliveryMode?
  sourceUrl             String?
  payload               Json?
  safetyPayload         Json?
  operatorNotes         String?
  occurredAt            DateTime                @default(now())
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client?                 @relation(fields: [clientId], references: [id])
  externalOrder         ExternalOrder?          @relation(fields: [externalOrderId], references: [id])
  job                   Job?                    @relation(fields: [jobId], references: [id])
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([organizationId, dedupeKey, eventType])
  @@index([organizationId, workflowStatus, occurredAt])
  @@index([organizationId, fiverrOrderId])
  @@index([jobId])
  @@index([externalOrderId])
}

enum CreditLedgerEntryType {
  PURCHASE
  MANUAL_ADJUSTMENT
  JOB_DEBIT
  REVISION_DEBIT
  REFUND_REVERSAL
  SUBSCRIPTION_ALLOWANCE
  EXPIRATION
  IMPORT_CORRECTION
}

enum ManualInvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
  FAILED
}

enum ManualInvoicePaymentStatus {
  DRAFT
  CONFIRMED
  REJECTED
  REVERSED
}

enum SubscriptionEntitlementStatus {
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
  PENDING_PAYMENT
}

model ManualInvoice {
  id              String                 @id @default(cuid())
  organizationId  String
  clientId        String?
  invoiceNumber   String
  status          ManualInvoiceStatus    @default(DRAFT)
  amountCents     Int
  paidCents       Int                    @default(0)
  currency        String                 @default("USD")
  creditsIncluded Int                    @default(0)
  packageKey      String?
  dueAt           DateTime?
  sentAt          DateTime?
  paidAt          DateTime?
  voidedAt        DateTime?
  clientNotes     String?
  internalNotes   String?
  createdByUserId String?
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client          Client?                @relation(fields: [clientId], references: [id])
  payments        ManualInvoicePayment[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId, status, createdAt])
  @@index([clientId, status])
  @@index([dueAt])
}

model ManualInvoicePayment {
  id                       String                     @id @default(cuid())
  organizationId           String
  clientId                 String?
  manualInvoiceId          String
  invoicePaymentId         String?
  amountCents              Int
  currency                 String                     @default("USD")
  status                   ManualInvoicePaymentStatus @default(CONFIRMED)
  paymentReferenceRedacted String?
  notes                    String?
  confirmedAt              DateTime?
  confirmedByUserId        String?
  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                   Client?                    @relation(fields: [clientId], references: [id])
  manualInvoice            ManualInvoice              @relation(fields: [manualInvoiceId], references: [id], onDelete: Cascade)
  invoicePayment           InvoicePayment?            @relation(fields: [invoicePaymentId], references: [id])
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([manualInvoiceId])
  @@index([clientId])
}

model SubscriptionEntitlement {
  id                    String                        @id @default(cuid())
  organizationId        String
  clientId              String?
  subscriptionId        String?
  entitlementKey        String
  monthlyImageAllowance Int                           @default(0)
  usedThisPeriod        Int                           @default(0)
  status                SubscriptionEntitlementStatus @default(ACTIVE)
  resetsAt              DateTime?
  source                String                        @default("subscription")
  metadata              Json?
  organization          Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client                Client?                       @relation(fields: [clientId], references: [id])
  subscription          Subscription?                 @relation(fields: [subscriptionId], references: [id])
  createdAt             DateTime                      @default(now())
  updatedAt             DateTime                      @updatedAt

  @@unique([organizationId, clientId, entitlementKey])
  @@index([organizationId, status])
  @@index([clientId, status])
  @@index([subscriptionId])
}

enum UpworkContractType {
  FIXED_PRICE
  HOURLY
  RETAINER
  AGENCY_SUBCONTRACT
  BULK_CATALOG
}

enum UpworkMilestoneStatus {
  NONE
  PROPOSED
  ACTIVE
  SUBMITTED
  APPROVED
  PAID
  PAUSED
  CLOSED
  DISPUTED
}

enum UpworkWorkflowStatus {
  DRAFT
  CONTRACT_CAPTURED
  FILES_NEEDED
  FILES_RECEIVED
  PROCESSING
  WAITING_FOR_REVIEW
  FLAGGED
  APPROVED
  DELIVERY_READY
  DELIVERED_IN_UPWORK
  REVISION_REQUESTED
  REPROCESSING
  RETAINER_REMINDER_SENT
  COMPLETED
  CANCELLED
  FAILED
}

enum UpworkDeliveryMode {
  UPWORK_ATTACHMENT
  UPWORK_MESSAGE_WITH_ALLOWED_LINK
  MANUAL_EXTERNAL_DELIVERY_RECORDED
}

enum UpworkRevisionStatus {
  NONE
  REQUESTED
  ACCEPTED
  IN_PROGRESS
  READY_FOR_REVIEW
  DELIVERED
  CLOSED
}

enum UpworkWorkflowEventType {
  CONTRACT_CAPTURED
  MAPPING_APPLIED
  CLIENT_MATCHED
  JOB_PLANNED
  UPLOAD_LINK_PLANNED
  PROPOSAL_TEMPLATE_GENERATED
  MESSAGE_TEMPLATE_GENERATED
  DELIVERY_TEMPLATE_GENERATED
  RETAINER_REMINDER_PLANNED
  REVISION_STATUS_UPDATED
  MANUAL_DELIVERY_RECORDED
