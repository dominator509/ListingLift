model UpworkWorkflowEvent {
  id                 String                  @id @default(cuid())
  organizationId     String
  clientId           String?
  externalOrderId    String?
  jobId              String?
  upworkContractId   String
  dedupeKey          String
  workflowStatus     UpworkWorkflowStatus    @default(DRAFT)
  eventType          UpworkWorkflowEventType
  revisionStatus     UpworkRevisionStatus    @default(NONE)
  clientNameRedacted String?
  contractTitle      String?
  contractType       UpworkContractType      @default(FIXED_PRICE)
  milestoneTitle     String?
  milestoneStatus    UpworkMilestoneStatus   @default(NONE)
  dueDate            DateTime?
  packageKey         String?
  billedAmountCents  Int?
  hourlyRateCents    Int?
  estimatedHours     Float?
  currency           String                  @default("USD")
  deliveryMode       UpworkDeliveryMode?
  sourceUrl          String?
  payload            Json?
  safetyPayload      Json?
  operatorNotes      String?
  occurredAt         DateTime                @default(now())
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client             Client?                 @relation(fields: [clientId], references: [id])
  externalOrder      ExternalOrder?          @relation(fields: [externalOrderId], references: [id])
  job                Job?                    @relation(fields: [jobId], references: [id])
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@unique([organizationId, dedupeKey, eventType])
  @@index([organizationId, workflowStatus, occurredAt])
  @@index([organizationId, upworkContractId])
  @@index([jobId])
  @@index([externalOrderId])
  @@index([dueDate])
}

