  @@index([organizationId, dedupeKey])
  @@index([clientId, createdAt])
  @@index([jobId])
}

model FiverrGigMapping {
  id                    String             @id @default(cuid())
  organizationId        String
  gigKey                String
  gigTitle              String
  searchHints           String[]           @default([])
