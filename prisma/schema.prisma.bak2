model MarketplaceExportMapping {
  id                   String                        @id @default(cuid())
  organizationId       String
  channelKey           String
  channelType          MarketplaceExportChannelType
  packageKey           String
  defaultPresetKeys    String[]                      @default([])
  defaultImageRoles    String[]                      @default([])
  defaultDeliveryMode  MarketplaceExportDeliveryMode @default(SELLER_EXPORT_PACKAGE)
  sellerReviewRequired Boolean                       @default(true)
  manualFallbackOnly   Boolean                       @default(true)
  supportsCsvImport    Boolean                       @default(true)
  supportsApiLater     Boolean                       @default(false)
  safeDescription      String
  active               Boolean                       @default(true)
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt            DateTime                      @default(now())
  updatedAt            DateTime                      @updatedAt

  @@unique([organizationId, channelKey])
  @@index([organizationId, active])
  @@index([organizationId, packageKey])
}

model MarketplaceExportWorkflowEvent {
  id                   String                             @id @default(cuid())
  organizationId       String
  clientId             String?
  externalOrderId      String?
  jobId                String?
  channelKey           String
  channelType          MarketplaceExportChannelType
  dedupeKey            String
  workflowStatus       MarketplaceExportWorkflowStatus    @default(DRAFT)
  eventType            MarketplaceExportWorkflowEventType
  deliveryMode         MarketplaceExportDeliveryMode?
  revisionStatus       MarketplaceExportRevisionStatus    @default(NONE)
  storeName            String?
  sellerName           String?
  buyerRedacted        String?
  externalReference    String?
  sourceUrl            String?
  sku                  String?
  productNames         String[]                           @default([])
  imageRoles           String[]                           @default([])
  presetKeys           String[]                           @default([])
  packageKey           String?
  orderAmountCents     Int?
  currency             String                             @default("USD")
  deadline             DateTime?
  externalLinkAllowed  Boolean                            @default(false)
  sellerReviewRequired Boolean                            @default(true)
  payload              Json?
  safetyPayload        Json?
  operatorNotes        String?
  occurredAt           DateTime                           @default(now())
  organization         Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client               Client?                            @relation(fields: [clientId], references: [id])
  externalOrder        ExternalOrder?                     @relation(fields: [externalOrderId], references: [id])
  job                  Job?                               @relation(fields: [jobId], references: [id])
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt

  @@unique([organizationId, dedupeKey, eventType])
  @@index([organizationId, channelKey, workflowStatus])
  @@index([organizationId, occurredAt])
  @@index([jobId])
  @@index([externalOrderId])
  @@index([deadline])
}

enum FileStorageProviderKey {
  LOCAL
  MOCK
  GOOGLE_DRIVE
  DROPBOX
  ONEDRIVE_LATER
  BOX_LATER
}

enum FileStorageConnectionStatus {
  DISABLED
  MOCK_ENABLED
  CONFIGURED
  NEEDS_AUTH
  HEALTHY
  DEGRADED
  FAILED
  REVOKED
}

enum FileStorageObjectKind {
  ORIGINAL_UPLOAD
  PROCESSED_OUTPUT
  PREVIEW_IMAGE
  DELIVERY_ARCHIVE
  MANIFEST
  README
  MANUAL_REPLACEMENT
  REPORT
  TEMPORARY_EXPORT
}

enum FileStorageOperationKind {
  UPLOAD
  DOWNLOAD
  COPY
  MOVE
  DELETE
  LIST
  SYNC_IN
  SYNC_OUT
  HEALTH_CHECK
  CREATE_FOLDER
}

enum FileStorageSyncStatus {
  PLANNED
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
  CANCELLED
}

model FileStorageConnection {
  id                String                      @id @default(cuid())
  organizationId    String
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerKey       FileStorageProviderKey
  displayName       String
  status            FileStorageConnectionStatus @default(DISABLED)
  rootFolderId      String?
  rootFolderPath    String?
  encryptedSecretId String?
  encryptedSecret   EncryptedSecret?            @relation(fields: [encryptedSecretId], references: [id])
  config            Json                        @default("{}")
  scopes            String[]                    @default([])
  lastHealthStatus  String?
  lastHealthMessage String?
  lastCheckedAt     DateTime?
  createdByUserId   String?
  updatedByUserId   String?
  revokedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  syncEvents        FileStorageSyncEvent[]
  externalFiles     ExternalFileReference[]

  @@unique([organizationId, providerKey, displayName])
  @@index([organizationId, providerKey])
  @@index([organizationId, status])
}

model ExternalFileReference {
  id                String                 @id @default(cuid())
  organizationId    String
  organization      Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId      String?
  connection        FileStorageConnection? @relation(fields: [connectionId], references: [id])
  providerKey       FileStorageProviderKey
  objectKind        FileStorageObjectKind
  jobId             String?
  job               Job?                   @relation(fields: [jobId], references: [id])
  clientId          String?
  client            Client?                @relation(fields: [clientId], references: [id])
  storageKey        String
  externalFileId    String?
  externalFolderId  String?
  fileName          String
  contentType       String?
  sizeBytes         BigInt?
  checksumSha256    String?
  sourceUrl         String?
  approvedForClient Boolean                @default(false)
  metadata          Json                   @default("{}")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([organizationId, providerKey, storageKey])
  @@index([organizationId, providerKey])
  @@index([organizationId, jobId])
  @@index([organizationId, clientId])
}

model FileStorageSyncEvent {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId    String?
  connection      FileStorageConnection?   @relation(fields: [connectionId], references: [id])
  providerKey     FileStorageProviderKey
  operation       FileStorageOperationKind
  status          FileStorageSyncStatus    @default(PLANNED)
  jobId           String?
  job             Job?                     @relation(fields: [jobId], references: [id])
  actorUserId     String?
  sourcePath      String?
  destinationPath String?
  fileCount       Int                      @default(0)
  errorMessage    String?
  metadata        Json                     @default("{}")
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  @@index([organizationId, providerKey, status])
  @@index([organizationId, jobId])
  @@index([createdAt])
}

