enum AgencyWorkspaceModeStatus {
  LEAD
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AgencyBrandingReviewStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  REJECTED
}

enum AgencyBulkProcessingStatus {
  PLANNED
  WAITING_FOR_UPLOADS
  READY_FOR_PROCESSING
  PROCESSING
  WAITING_FOR_REVIEW
  FLAGGED
  READY_FOR_DELIVERY
  DELIVERED
  BLOCKED
}

enum AgencyVolumePricingTier {
  STARTER
  GROWTH
  SCALE
  CUSTOM
}

enum AgencyWhiteLabelEventType {
  VIEW
  OPEN_WORKSPACE
  CREATE_WORKSPACE_DRAFT
  UPDATE_BRAND_SETTINGS_DRAFT
  PREVIEW_BRANDED_DELIVERY
  PREVIEW_BRANDED_REPORT
  PLAN_BULK_QUEUE
  QUOTE_VOLUME_PRICING
  INVITE_TEAM_MEMBER_DRAFT
  REQUEST_MANUAL_REVIEW
}

model AgencyWorkspaceSetting {
  id                    String                    @id @default(cuid())
  organizationId        String
  clientId              String?
  workspaceName         String
  status                AgencyWorkspaceModeStatus @default(LEAD)
  sourceChannels        String[]                  @default([])
  whiteLabelEnabled     Boolean                   @default(true)
  brandedReportsEnabled Boolean                   @default(true)
  monthlyImageVolume    Int                       @default(0)
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, whiteLabelEnabled])
}

model AgencyBrandingReview {
  id                      String                     @id @default(cuid())
  organizationId          String
  clientId                String?
  portalName              String?
  logoUrl                 String?
  primaryColor            String?
  secondaryColor          String?
  supportEmail            String?
  customDomain            String?
  deliveryFooter          String?
  hideListingLiftBranding Boolean                    @default(false)
  reviewStatus            AgencyBrandingReviewStatus @default(DRAFT)
  reviewedByUserId        String?
  reviewedAt              DateTime?
  rejectionReason         String?
  metadata                Json?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([organizationId, reviewStatus])
  @@index([organizationId, clientId])
}

model AgencyBrandedDeliveryTemplate {
  id                   String                     @id @default(cuid())
  organizationId       String
  clientId             String?
  workspaceId          String?
  templateName         String
  title                String
  body                 String
  footer               String?
  includeReportLink    Boolean                    @default(true)
  approvalGateRequired Boolean                    @default(true)
  tokenGateRequired    Boolean                    @default(true)
  reviewStatus         AgencyBrandingReviewStatus @default(DRAFT)
  metadata             Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([organizationId, clientId])
  @@index([organizationId, reviewStatus])
}

model AgencyBrandedReportTemplate {
  id                  String                     @id @default(cuid())
  organizationId      String
  clientId            String?
  workspaceId         String?
  reportType          String
  templateName        String
  sections            String[]                   @default([])
  includeUpsellDrafts Boolean                    @default(false)
  reviewStatus        AgencyBrandingReviewStatus @default(DRAFT)
  metadata            Json?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([organizationId, clientId])
  @@index([organizationId, reportType])
  @@index([organizationId, reviewStatus])
}

model AgencyBulkProcessingBatch {
  id                   String                     @id @default(cuid())
  organizationId       String
  workspaceId          String?
  clientId             String?
  name                 String
  status               AgencyBulkProcessingStatus @default(PLANNED)
  priority             JobPriority                @default(NORMAL)
  totalJobs            Int                        @default(0)
  totalImages          Int                        @default(0)
  manualReviewRequired Boolean                    @default(true)
  metadata             Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, workspaceId])
  @@index([organizationId, clientId])
}

model AgencyBulkProcessingItem {
  id                   String                     @id @default(cuid())
  organizationId       String
  batchId              String?
  workspaceId          String?
  clientId             String?
  jobId                String?
  status               AgencyBulkProcessingStatus @default(PLANNED)
  imageCount           Int                        @default(0)
  manualReviewRequired Boolean                    @default(true)
  metadata             Json?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  @@index([organizationId, batchId])
  @@index([organizationId, status])
  @@index([organizationId, jobId])
}

model AgencyVolumePricingQuote {
  id                    String                  @id @default(cuid())
  organizationId        String
  tier                  AgencyVolumePricingTier @default(STARTER)
  workspaceCount        Int                     @default(0)
  monthlyImageVolume    Int                     @default(0)
  includedImages        Int                     @default(0)
  overageImages         Int                     @default(0)
  baseMonthlyCents      Int                     @default(0)
  addOnCents            Int                     @default(0)
  estimatedMonthlyCents Int                     @default(0)
  currency              String                  @default("USD")
  manualReviewRequired  Boolean                 @default(true)
  approvedByUserId      String?
  approvedAt            DateTime?
  metadata              Json?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@index([organizationId, createdAt])
  @@index([organizationId, tier])
}

model AgencyTeamInvite {
  id                 String    @id @default(cuid())
  organizationId     String
  email              String
  name               String
  roleKey            RoleKey
  clientWorkspaceIds String[]  @default([])
  inviteTokenHash    String
  expiresAt          DateTime
  acceptedAt         DateTime?
  revokedAt          DateTime?
  createdByUserId    String?
  metadata           Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([organizationId, email])
  @@index([organizationId, roleKey])
  @@index([expiresAt])
}

model AgencyWhiteLabelEvent {
  id             String                    @id @default(cuid())
  organizationId String
  userId         String?
  clientId       String?
  workspaceId    String?
  jobId          String?
  section        String
  eventType      AgencyWhiteLabelEventType
  metadata       Json?
  createdAt      DateTime                  @default(now())

  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, clientId])
  @@index([organizationId, workspaceId])
}

// Phase 36 — API Access and Advanced Integrations Scaffold.
// Codex must validate and regenerate the migration SQL in the target runtime.

enum ApiAccessTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED
  ROTATED
}

enum ApiAccessEventType {
  CREATED
  TOKEN_SHOWN_ONCE
  SCOPE_CHECKED
  TOKEN_REVOKED
  TOKEN_ROTATED
  PLAN_GATE_EVALUATED
  WEBHOOK_MANAGED
  SHARED_UPLOAD_PORTAL_CREATED
  API_REQUEST_RECEIVED
  RATE_LIMITED
}

enum AdvancedIntegrationProvider {
  ZAPIER
  MAKE
  N8N
  CUSTOM_API
  WEBHOOK
}

enum AdvancedIntegrationConnectionStatus {
  DRAFT
  READY
  DISABLED
  ERROR
}

enum ApiWebhookSubscriptionStatus {
  DRAFT
  ENABLED
  PAUSED
  FAILED
}

enum SharedUploadPortalStatus {
  DRAFT
  ACTIVE
  EXPIRED
  REVOKED
}

model ApiAccessToken {
  id                 String               @id @default(cuid())
  organizationId     String
  clientId           String?
  agencyWorkspaceId  String?
  label              String
  tokenHash          String               @unique
  tokenPrefix        String
  scopes             String[]             @default([])
  status             ApiAccessTokenStatus @default(ACTIVE)
  planKey            String               @default("AGENCY")
  createdByUserId    String?
  shownAt            DateTime?
  lastUsedAt         DateTime?
  expiresAt          DateTime?
  revokedAt          DateTime?
  rotatedFromTokenId String?
  metadata           Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, agencyWorkspaceId])
  @@index([organizationId, planKey])
  @@index([tokenPrefix])
  @@index([expiresAt])
}

model AdvancedIntegrationConnection {
  id                 String                              @id @default(cuid())
  organizationId     String
  provider           AdvancedIntegrationProvider
  label              String
  status             AdvancedIntegrationConnectionStatus @default(DRAFT)
  scopes             String[]                            @default([])
  callbackUrl        String?
  encryptedSecretRef String?
  featureFlagKey     String                              @default("ENABLE_ADVANCED_INTEGRATIONS")
  disabledByDefault  Boolean                             @default(true)
  createdByUserId    String?
  lastHealthCheckAt  DateTime?
  lastErrorAt        DateTime?
  metadata           Json?
  createdAt          DateTime                            @default(now())
  updatedAt          DateTime                            @updatedAt

  @@index([organizationId, provider])
  @@index([organizationId, status])
  @@index([organizationId, featureFlagKey])
}

model ApiWebhookSubscription {
  id                 String                       @id @default(cuid())
  organizationId     String
  tokenId            String?
  provider           AdvancedIntegrationProvider  @default(WEBHOOK)
  targetUrl          String
  eventTypes         String[]                     @default([])
  signingSecretHash  String?
  encryptedSecretRef String?
  status             ApiWebhookSubscriptionStatus @default(DRAFT)
  failureCount       Int                          @default(0)
  lastDeliveredAt    DateTime?
  lastFailedAt       DateTime?
  createdByUserId    String?
  metadata           Json?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, tokenId])
  @@index([organizationId, provider])
}

model SharedUploadPortalLink {
  id                   String                   @id @default(cuid())
  organizationId       String
  clientId             String?
  jobId                String?
  agencyWorkspaceId    String?
  label                String
  tokenHash            String                   @unique
  tokenPrefix          String
  status               SharedUploadPortalStatus @default(DRAFT)
  allowedUploadKinds   String[]                 @default([])
  expiresAt            DateTime
  maxFiles             Int                      @default(100)
  usedFileCount        Int                      @default(0)
  manualReviewRequired Boolean                  @default(true)
  createdByUserId      String?
  revokedAt            DateTime?
  metadata             Json?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, clientId])
  @@index([organizationId, jobId])
  @@index([organizationId, agencyWorkspaceId])
  @@index([expiresAt])
}

model ApiAccessEvent {
  id             String             @id @default(cuid())
  organizationId String
  userId         String?
  tokenId        String?
  scope          String?
  eventType      ApiAccessEventType
  route          String?
  ipHash         String?
  userAgentHash  String?
  metadata       Json?
  createdAt      DateTime           @default(now())

  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, tokenId, createdAt])
  @@index([organizationId, scope, createdAt])
}

// Phase 37 — Security Hardening.
// Codex must validate and regenerate the migration SQL in the target runtime.

enum SecurityControlArea {
  SECRET_STORAGE
  UPLOAD_VALIDATION
  ZIP_SAFETY
  TOKEN_LIFECYCLE
  RATE_LIMITS
  SECURITY_HEADERS
  CSRF
  XSS_OUTPUT
  WEBHOOK_SIGNATURES
  AUDIT_COMPLETENESS
  TENANT_RBAC
}

enum SecurityControlStatus {
  NOT_STARTED
  SCAFFOLDED
  CODEX_REQUIRED
  VERIFIED
  BLOCKED
}

enum SecurityHardeningEventType {
  SECRET_REFERENCE_CREATED
  SECRET_REFERENCE_ROTATED
  UPLOAD_REJECTED
  ZIP_ENTRY_REJECTED
  TOKEN_ISSUED
  TOKEN_REVOKED
  RATE_LIMITED
  SECURITY_HEADER_APPLIED
  CSRF_TOKEN_CREATED
  CSRF_TOKEN_VERIFIED
  XSS_OUTPUT_REJECTED
  WEBHOOK_REJECTED
  RBAC_DENIED
  DELIVERY_DOWNLOAD_ATTEMPTED
  MANUAL_OVERRIDE
  SECURITY_CONTROL_VERIFIED
}

model SecuritySecretReference {
  id                 String                @id @default(cuid())
  organizationId     String
  provider           String
  secretClass        String
  label              String
  encryptedSecretRef String
  status             SecurityControlStatus @default(SCAFFOLDED)
  createdByUserId    String?
  rotatedAt          DateTime?
  revokedAt          DateTime?
  metadata           Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([organizationId, provider])
  @@index([organizationId, secretClass])
  @@index([organizationId, status])
}

model SecurityRateLimitRule {
  id             String                @id @default(cuid())
  organizationId String?
  action         String
  subject        String
  limit          Int
  windowSeconds  Int
  status         SecurityControlStatus @default(CODEX_REQUIRED)
  metadata       Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([organizationId, action])
  @@index([status])
}

model SecurityAuditCoverageItem {
  id                String                @id @default(cuid())
  organizationId    String?
  action            String
  surface           String
  eventType         String
  controlArea       SecurityControlArea
  requiredMetadata  String[]              @default([])
  forbiddenMetadata String[]              @default([])
  status            SecurityControlStatus @default(CODEX_REQUIRED)
  verifiedAt        DateTime?
  verifiedByUserId  String?
  metadata          Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([organizationId, controlArea])
  @@index([organizationId, status])
  @@index([action])
}

model SecurityCsrfToken {
  id             String    @id @default(cuid())
  organizationId String
  sessionHash    String
  tokenHash      String    @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId, sessionHash])
  @@index([organizationId, expiresAt])
}

model SecurityHardeningEvent {
  id             String                     @id @default(cuid())
  organizationId String
  userId         String?
  eventType      SecurityHardeningEventType
  controlArea    SecurityControlArea
  route          String?
  resourceType   String?
  resourceId     String?
  ipHash         String?
  userAgentHash  String?
  metadata       Json?
  createdAt      DateTime                   @default(now())

  @@index([organizationId, eventType, createdAt])
  @@index([organizationId, controlArea, createdAt])
  @@index([organizationId, resourceType, resourceId])
}

// Phase 38 — Full Testing and QA.
// Codex must validate and regenerate the migration SQL in the target runtime.

enum QaTestLayer {
  ENVIRONMENT
  PRISMA
  SEED
  TYPECHECK
  LINT
  UNIT
  SECURITY
  INTEGRATION
  ADAPTER_CONTRACT
  E2E
  BUILD
  SMOKE
  BROWSER
}

enum QaCheckStatus {
  NOT_RUN
  SCAFFOLDED
  CODEX_REQUIRED
  PASS
  FAIL
  BLOCKED
}

enum QaEvidenceType {
  COMMAND_OUTPUT
  SCREENSHOT
  TRACE
  LOG
  DATABASE_RECORD
  MANUAL_REVIEW_NOTE
  ARTIFACT
}

enum QaSeverity {
  BLOCKER
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

model QaRun {
  id              String        @id @default(cuid())
  organizationId  String
  packageVersion  String
  phase           Int           @default(38)
  status          QaCheckStatus @default(CODEX_REQUIRED)
  startedByUserId String?
  startedAt       DateTime?
  completedAt     DateTime?
  summary         String?
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([organizationId, packageVersion])
  @@index([organizationId, status])
  @@index([organizationId, phase])
}

model QaCheckResult {
  id             String        @id @default(cuid())
  organizationId String
  qaRunId        String?
  packageVersion String
  phase          Int           @default(38)
  checkKey       String
  layer          QaTestLayer
  status         QaCheckStatus @default(CODEX_REQUIRED)
  severity       QaSeverity    @default(HIGH)
  command        String?
  exitCode       Int?
  startedAt      DateTime?
  completedAt    DateTime?
  evidenceCount  Int           @default(0)
  blocker        Boolean       @default(true)
  notes          String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, packageVersion, phase])
  @@index([organizationId, layer, status])
  @@index([organizationId, checkKey])
}

model QaEvidenceReference {
  id              String         @id @default(cuid())
  organizationId  String
  qaCheckResultId String?
  evidenceType    QaEvidenceType
  evidenceRef     String
  redacted        Boolean        @default(true)
  note            String?
  createdByUserId String?
  createdAt       DateTime       @default(now())

  @@index([organizationId, qaCheckResultId])
  @@index([organizationId, evidenceType])
}

model QaSmokeRouteResult {
  id             String        @id @default(cuid())
  organizationId String
  qaRunId        String?
  routeGroup     String
  routePath      String
  status         QaCheckStatus @default(CODEX_REQUIRED)
  httpStatus     Int?
  screenshotRef  String?
  traceRef       String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([organizationId, routeGroup])
  @@index([organizationId, status])
  @@index([organizationId, routePath])
}




model QaVerificationLedger {
  id           String   @id @default(cuid())
  organizationId String
  packageVersion String
  phase        Int
  checkKey     String
  layer        QaTestLayer
  status       QaCheckStatus
  severity     QaSeverity
  command      String?
  exitCode     Int?
  evidenceCount Int
  notes        String?
  accepted     Boolean
  productionReleaseAllowed Boolean
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([organizationId, packageVersion, phase, checkKey])
}
