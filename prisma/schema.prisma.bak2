  ALLOWED
  NEEDS_MANUAL_REVIEW
  BLOCKED
}

model AdvancedImageProcessingRecipe {
  id                   String                   @id @default(cuid())
  organizationId       String?
  organization         Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key                  String
  label                String
  description          String?
  operations           AdvancedImageOperation[] @default([])
  recommendedPackages  String[]                 @default([])
  defaultOutputFolder  String
  safeClaim            String
  enabled              Boolean                  @default(true)
  requiresApproval     Boolean                  @default(true)
  sellerReviewRequired Boolean                  @default(true)
  metadata             Json                     @default("{}")
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@unique([organizationId, key])
  @@index([organizationId, enabled])
}

model AdvancedImageProcessingRun {
  id             String                    @id @default(cuid())
  organizationId String
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId          String
  job            Job                       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recipeKey      String
  status         AdvancedImageRunStatus    @default(DRAFT)
  safetyStatus   AdvancedImageSafetyStatus @default(NEEDS_MANUAL_REVIEW)
  operationPlan  Json                      @default("{}")
  outputPlan     Json                      @default("{}")
  reportId       String?
  queuedByUserId String?
  startedAt      DateTime?
  completedAt    DateTime?
  errorMessage   String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([organizationId, jobId, status])
  @@index([organizationId, recipeKey])
}

model AdvancedImageProcessingReport {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobId             String
  job               Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  runId             String?
  title             String
  summary           String
  warnings          String[]     @default([])
  recommendations   String[]     @default([])
  sequencePlan      Json         @default("{}")
  qualityScores     Json         @default("{}")
  safeClaim         String
  approvedForClient Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([organizationId, jobId])
  @@index([organizationId, approvedForClient])
}

