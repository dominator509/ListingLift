  productNameHints       String[]               @default([])
  permalinkHints         String[]               @default([])
  packageKey             String?
  imageAllowance         Int?
  creditAmount           Int                    @default(0)
  revisionAllowance      Int                    @default(0)
  fulfillmentKind        GumroadFulfillmentKind @default(IMAGE_PACK_JOB)
  createsJob             Boolean                @default(true)
  sendsUploadLink        Boolean                @default(true)
  sendsAdminNotification Boolean                @default(true)
  safeDescription        String
  active                 Boolean                @default(true)
  organization           Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@unique([organizationId, offerKey])
  @@unique([organizationId, productId])
  @@index([organizationId, active])
  @@index([organizationId, fulfillmentKind])
}

model GumroadWebhookEvent {
  id                 String                         @id @default(cuid())
  organizationId     String?
  clientId           String?
  externalOrderId    String?
  jobId              String?
  gumroadSaleId      String                         @unique
  productId          String?
  permalink          String?
  productName        String?
