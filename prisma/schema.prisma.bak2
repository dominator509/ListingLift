  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@unique([organizationId, dedupeKey, providerKey, actionKey])
  @@index([organizationId, providerKey, status])
  @@index([organizationId, jobId])
}

model TaskDataExport {
  id              String                      @id @default(cuid())
  organizationId  String
  organization    Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectionId    String?
  connection      TaskNotificationConnection? @relation(fields: [connectionId], references: [id])
