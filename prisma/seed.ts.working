import bcrypt from 'bcryptjs';
import { DEFAULT_PACKAGES } from '../src/domain/packages';
import { DEFAULT_PLATFORM_PRESETS } from '../src/domain/platform-presets';
import { DEFAULT_ROLES, DEFAULT_PERMISSIONS } from '../src/domain/roles';
import { DEFAULT_SALES_CHANNELS } from '../src/domain/sales-channels';
import { SALES_CHANNEL_ADAPTER_KEY_BY_CHANNEL } from '../src/domain/sales-channel-normalization';
import { DEFAULT_IMAGE_PROVIDER_DEFINITIONS } from '../src/domain/image-providers';
import { DEFAULT_GUMROAD_OFFER_MAPPINGS } from '../src/domain/gumroad';
import { DEFAULT_OTHER_SALES_CHANNELS, OTHER_SALES_CHANNEL_SAFETY_RULES } from '../src/domain/generic-sales-channels';

import { PrismaClient } from '@prisma/client';

const globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };

export const prisma = globalForPrisma.prisma ?? new PrismaClient();

if (process.env.NODE_ENV !== 'production') globalForPrisma.prisma = prisma;
      where: { key: role.key },
      update: { name: role.name, description: role.description, system: true },
      create: { key: role.key, name: role.name, description: role.description, system: true },
    });

    for (const permissionKey of role.permissions) {
      const permissionId = permissionByKey.get(permissionKey);
      if (!permissionId) continue;
      await prisma.rolePermission.upsert({
        where: { roleId_permissionId: { roleId: roleRecord.id, permissionId } },
        update: {},
        create: { roleId: roleRecord.id, permissionId },
      });
    }
  }
}

async function main() {
  await seedRolesAndPermissions();

  const demoPasswordHash = await bcrypt.hash('DemoPassword123', 12);

  const org = await prisma.organization.upsert({
    where: { slug: 'demo-listinglift' },
    update: { name: 'Demo ListingLift Workspace', organizationType: 'AGENCY' },
    create: { name: 'Demo ListingLift Workspace', slug: 'demo-listinglift', organizationType: 'AGENCY' },
  });

  const superAdminRole = await prisma.role.findUniqueOrThrow({ where: { key: 'SUPER_ADMIN' } });
  const agencyAdminRole = await prisma.role.findUniqueOrThrow({ where: { key: 'AGENCY_ADMIN' } });
  const clientOwnerRole = await prisma.role.findUniqueOrThrow({ where: { key: 'CLIENT_OWNER' } });

  const user = await prisma.user.upsert({
    where: { email: 'demo-super-admin@example.com' },
    update: { name: 'Demo Super Admin', accountStatus: 'ACTIVE', passwordHash: demoPasswordHash },
    create: { email: 'demo-super-admin@example.com', name: 'Demo Super Admin', accountStatus: 'ACTIVE', passwordHash: demoPasswordHash },
  });

  await prisma.membership.upsert({
    where: { organizationId_userId: { organizationId: org.id, userId: user.id } },
    update: { roleId: superAdminRole.id, roleKey: 'SUPER_ADMIN' },
    create: { organizationId: org.id, userId: user.id, roleId: superAdminRole.id, roleKey: 'SUPER_ADMIN' },
  });


  for (const mapping of DEFAULT_GUMROAD_OFFER_MAPPINGS) {
    await prisma.gumroadProductMapping.upsert({
      where: { organizationId_offerKey: { organizationId: org.id, offerKey: mapping.key } },
      update: {
        label: mapping.label,
        productNameHints: mapping.productNameHints,
        permalinkHints: mapping.permalinkHints,
        packageKey: mapping.packageKey,
        imageAllowance: mapping.imageAllowance,
        creditAmount: mapping.creditAmount,
        revisionAllowance: mapping.revisionAllowance,
        fulfillmentKind: mapping.fulfillmentKind,
        createsJob: mapping.createsJob,
        sendsUploadLink: mapping.sendsUploadLink,
        sendsAdminNotification: mapping.sendsAdminNotification,
        safeDescription: mapping.safeDescription,
        active: true,
      },
      create: {
        organizationId: org.id,
        offerKey: mapping.key,
        label: mapping.label,
        productNameHints: mapping.productNameHints,
        permalinkHints: mapping.permalinkHints,
        packageKey: mapping.packageKey,
        imageAllowance: mapping.imageAllowance,
        creditAmount: mapping.creditAmount,
        revisionAllowance: mapping.revisionAllowance,
        fulfillmentKind: mapping.fulfillmentKind,
        createsJob: mapping.createsJob,
        sendsUploadLink: mapping.sendsUploadLink,
        sendsAdminNotification: mapping.sendsAdminNotification,
        safeDescription: mapping.safeDescription,
        active: true,
      },
    });
  }

  await prisma.brandSetting.upsert({
    where: { organizationId: org.id },
    update: { portalName: 'ListingLift Demo Portal', deliveryFooter: 'Platform-ready draft. Seller review recommended before publishing.' },
    create: { organizationId: org.id, portalName: 'ListingLift Demo Portal', deliveryFooter: 'Platform-ready draft. Seller review recommended before publishing.' },
  });

  for (const pkg of DEFAULT_PACKAGES) {
    await prisma.package.upsert({
      where: { key: pkg.key },
      update: {
        publicSlug: pkg.publicSlug,
        name: pkg.name,
        shortName: pkg.shortName,
        category: pkg.category,
        description: pkg.description,
        positioning: pkg.positioning,
        imageMin: pkg.imageMin,
        imageMax: pkg.imageMax,
        imageAllowance: pkg.imageAllowance,
        priceMinCents: pkg.priceMinCents,
        priceMaxCents: pkg.priceMaxCents,
        currency: pkg.currency,
        billingInterval: pkg.billingInterval,
        checkoutMode: pkg.checkoutMode,
        deliveryWindowDays: pkg.deliveryWindowDays,
        revisionAllowance: pkg.revisionAllowance,
        includedOutputTypes: pkg.includedOutputTypes,
        defaultSalesChannelKeys: pkg.defaultSalesChannelKeys,
        features: pkg.features,
        recommendedFor: pkg.recommendedFor,
        deliverables: pkg.deliverables,
        pricePolicy: pkg.pricePolicy as Prisma.InputJsonValue,
        safeClaim: pkg.safeClaim,
        upsellPackageKeys: pkg.upsellPackageKeys,
        popular: pkg.popular,
        sortOrder: pkg.sortOrder,
        active: pkg.active,
        manualReviewRequired: pkg.manualReviewRequired,
      },
      create: {
        key: pkg.key,
        publicSlug: pkg.publicSlug,
        name: pkg.name,
        shortName: pkg.shortName,
        category: pkg.category,
        description: pkg.description,
        positioning: pkg.positioning,
        imageMin: pkg.imageMin,
        imageMax: pkg.imageMax,
        imageAllowance: pkg.imageAllowance,
        priceMinCents: pkg.priceMinCents,
        priceMaxCents: pkg.priceMaxCents,
        currency: pkg.currency,
        billingInterval: pkg.billingInterval,
        checkoutMode: pkg.checkoutMode,
        deliveryWindowDays: pkg.deliveryWindowDays,
        revisionAllowance: pkg.revisionAllowance,
        includedOutputTypes: pkg.includedOutputTypes,
        defaultSalesChannelKeys: pkg.defaultSalesChannelKeys,
        features: pkg.features,
        recommendedFor: pkg.recommendedFor,
        deliverables: pkg.deliverables,
        pricePolicy: pkg.pricePolicy as Prisma.InputJsonValue,
        safeClaim: pkg.safeClaim,
        upsellPackageKeys: pkg.upsellPackageKeys,
        popular: pkg.popular,
        sortOrder: pkg.sortOrder,
        active: pkg.active,
        manualReviewRequired: pkg.manualReviewRequired,
      },
    });
  }

  for (const preset of DEFAULT_PLATFORM_PRESETS) {
    await prisma.platformPreset.upsert({
      where: { key: preset.key },
      update: {
        platform: preset.platform,
        platformKey: preset.platformKey,
        name: preset.name,
        description: preset.description,
        width: preset.width,
        height: preset.height,
        aspectRatio: preset.aspectRatio,
        orientation: preset.orientation,
        format: preset.format,
        folderPath: preset.folderPath,
        folderDestination: preset.folderDestination as Prisma.InputJsonValue,
        background: preset.background,
        compressionTargetKb: preset.compressionTargetKb,
        maxFileSizeKb: preset.maxFileSizeKb,
        safeMarginPercent: preset.safeMarginPercent,
        namingConvention: preset.namingConvention,
        recommendedUse: preset.recommendedUse,
        qualityChecks: preset.qualityChecks,
        channelTags: preset.channelTags,
        safeLanguage: preset.safeLanguage,
        marketplaceSafeClaim: preset.marketplaceSafeClaim,
        sellerReviewRequired: preset.sellerReviewRequired,
        supportsTransparent: preset.supportsTransparent,
        supportsWhiteBackground: preset.supportsWhiteBackground,
        editable: preset.editable,
        system: preset.system,
        sortOrder: preset.sortOrder,
        active: preset.active ?? true,
      },
      create: {
        key: preset.key,
        platform: preset.platform,
        platformKey: preset.platformKey,
        name: preset.name,
        description: preset.description,
        width: preset.width,
        height: preset.height,
        aspectRatio: preset.aspectRatio,
        orientation: preset.orientation,
        format: preset.format,
        folderPath: preset.folderPath,
        folderDestination: preset.folderDestination as Prisma.InputJsonValue,
        background: preset.background,
        compressionTargetKb: preset.compressionTargetKb,
        maxFileSizeKb: preset.maxFileSizeKb,
        safeMarginPercent: preset.safeMarginPercent,
        namingConvention: preset.namingConvention,
        recommendedUse: preset.recommendedUse,
        qualityChecks: preset.qualityChecks,
        channelTags: preset.channelTags,
        safeLanguage: preset.safeLanguage,
        marketplaceSafeClaim: preset.marketplaceSafeClaim,
        sellerReviewRequired: preset.sellerReviewRequired,
        supportsTransparent: preset.supportsTransparent,
        supportsWhiteBackground: preset.supportsWhiteBackground,
        editable: preset.editable,
        system: preset.system,
        sortOrder: preset.sortOrder,
        active: preset.active ?? true,
      },
    });
  }

  const salesChannelByKey = new Map<string, string>();
  for (const channel of DEFAULT_SALES_CHANNELS) {
    const record = await prisma.salesChannel.upsert({
      where: { organizationId_key: { organizationId: org.id, key: channel.key } },
      update: {
        name: channel.name,
        channelType: channel.channelType,
        mode: channel.defaultMode,
        canonicalKey: channel.key,
        adapterKey: SALES_CHANNEL_ADAPTER_KEY_BY_CHANNEL[channel.key],
        supportedModes: [channel.defaultMode, 'MANUAL'],
        enabled: channel.enabledByDefault,
        notes: channel.marketplaceSafety.join(' '),
        marketplaceSafetyRules: channel.marketplaceSafety,
        manualFallbackEnabled: true,
        revenueAttributionEnabled: true,
      },
      create: {
        organizationId: org.id,
        key: channel.key,
        name: channel.name,
        channelType: channel.channelType,
        mode: channel.defaultMode,
        canonicalKey: channel.key,
        adapterKey: SALES_CHANNEL_ADAPTER_KEY_BY_CHANNEL[channel.key],
        supportedModes: [channel.defaultMode, 'MANUAL'],
        enabled: channel.enabledByDefault,
        notes: channel.marketplaceSafety.join(' '),
        marketplaceSafetyRules: channel.marketplaceSafety,
        manualFallbackEnabled: true,
        revenueAttributionEnabled: true,
      },
    });
    salesChannelByKey.set(record.key, record.id);
  }


  for (const channel of DEFAULT_OTHER_SALES_CHANNELS) {
    await prisma.genericSalesChannelMapping.upsert({
      where: { organizationId_channelKey: { organizationId: org.id, channelKey: channel.key } },
      update: {
        label: channel.label,
        category: channel.category,
        defaultPackageKey: channel.defaultPackageKey,
        defaultIntent: channel.defaultIntent,
        defaultDeliveryMode: channel.defaultDeliveryMode,
        sourceHints: channel.sourceHints,
        manualOnly: channel.manualOnly,
        supportsProposalTemplate: channel.supportsProposalTemplate,
        supportsFollowUp: channel.supportsFollowUp,
        revenueAttributionRequired: channel.revenueAttributionRequired,
        marketplaceSafetyRules: [...OTHER_SALES_CHANNEL_SAFETY_RULES],
        active: true,
      },
      create: {
        organizationId: org.id,
        channelKey: channel.key,
        label: channel.label,
        category: channel.category,
        defaultPackageKey: channel.defaultPackageKey,
        defaultIntent: channel.defaultIntent,
        defaultDeliveryMode: channel.defaultDeliveryMode,
        sourceHints: channel.sourceHints,
        manualOnly: channel.manualOnly,
        supportsProposalTemplate: channel.supportsProposalTemplate,
        supportsFollowUp: channel.supportsFollowUp,
        revenueAttributionRequired: channel.revenueAttributionRequired,
        marketplaceSafetyRules: [...OTHER_SALES_CHANNEL_SAFETY_RULES],
        active: true,
      },
    });
  }


  for (const provider of DEFAULT_IMAGE_PROVIDER_DEFINITIONS) {
    const secretStatus = {
      requiredSecretNames: provider.secretEnvVars,
      complete: provider.secretEnvVars.length === 0,
      storageRule: 'EncryptedSecret references only; no plaintext provider secrets in seed data.',
    } as Prisma.InputJsonValue;

    await prisma.imageProviderConfiguration.upsert({
      where: { organizationId_providerKey: { organizationId: org.id, providerKey: provider.key } },
      update: {
        enabled: provider.key === 'mock-image-provider',
        mode: provider.key === 'mock-image-provider' ? 'MOCK' : 'API',
        status: provider.key === 'mock-image-provider' ? 'HEALTHY' : provider.secretEnvVars.length ? 'NEEDS_SECRETS' : 'DISABLED',
        priority: provider.key === 'mock-image-provider' ? 1 : 100,
        capabilities: provider.capabilities,
        config: { seed: true, featureFlag: provider.enabledFeatureFlag, realCallsFeatureFlag: provider.realCallsFeatureFlag ?? null } as Prisma.InputJsonValue,
        secretStatus,
        healthStatus: provider.key === 'mock-image-provider' ? 'HEALTHY' : 'BLOCKED',
        healthMessage: provider.key === 'mock-image-provider' ? 'Mock provider seeded as baseline-ready.' : 'Real provider seeded disabled. Codex must configure encrypted secrets and feature flags before use.',
        lastHealthCheckedAt: new Date(),
        manualFallbackEnabled: true,
      },
      create: {
        organizationId: org.id,
        providerKey: provider.key,
        enabled: provider.key === 'mock-image-provider',
        mode: provider.key === 'mock-image-provider' ? 'MOCK' : 'API',
        status: provider.key === 'mock-image-provider' ? 'HEALTHY' : provider.secretEnvVars.length ? 'NEEDS_SECRETS' : 'DISABLED',
        priority: provider.key === 'mock-image-provider' ? 1 : 100,
        capabilities: provider.capabilities,
        config: { seed: true, featureFlag: provider.enabledFeatureFlag, realCallsFeatureFlag: provider.realCallsFeatureFlag ?? null } as Prisma.InputJsonValue,
        secretStatus,
        healthStatus: provider.key === 'mock-image-provider' ? 'HEALTHY' : 'BLOCKED',
        healthMessage: provider.key === 'mock-image-provider' ? 'Mock provider seeded as baseline-ready.' : 'Real provider seeded disabled. Codex must configure encrypted secrets and feature flags before use.',
        lastHealthCheckedAt: new Date(),
        manualFallbackEnabled: true,
      },
    });
  }

  const client = await prisma.client.upsert({
    where: { organizationId_email: { organizationId: org.id, email: 'seller@example.com' } },
    update: {
      name: 'Demo Seller',
      businessName: 'Demo Storefront',
      contactName: 'Demo Seller',
      storeUrl: 'https://example.com/demo-store',
      buyerType: 'Marketplace seller',
      primarySalesChannel: 'Direct',
      sourceChannel: 'Direct',
      status: 'ACTIVE',
      creditBalance: 25,
      assignedAdminUserId: user.id,
    },
    create: {
      organizationId: org.id,
      assignedAdminUserId: user.id,
      name: 'Demo Seller',
      businessName: 'Demo Storefront',
      contactName: 'Demo Seller',
      email: 'seller@example.com',
      storeUrl: 'https://example.com/demo-store',
      buyerType: 'Marketplace seller',
      primarySalesChannel: 'Direct',
      sourceChannel: 'Direct',
      status: 'ACTIVE',
      creditBalance: 25,
    },
  });

  const agencyAdmin = await prisma.user.upsert({
    where: { email: 'demo-agency-admin@example.com' },
    update: { name: 'Demo Agency Admin', accountStatus: 'ACTIVE', passwordHash: demoPasswordHash },
    create: { email: 'demo-agency-admin@example.com', name: 'Demo Agency Admin', accountStatus: 'ACTIVE', passwordHash: demoPasswordHash },
  });

  await prisma.membership.upsert({
    where: { organizationId_userId: { organizationId: org.id, userId: agencyAdmin.id } },
    update: { roleId: agencyAdminRole.id, roleKey: 'AGENCY_ADMIN', clientId: null, agencyScope: true },
    create: { organizationId: org.id, userId: agencyAdmin.id, roleId: agencyAdminRole.id, roleKey: 'AGENCY_ADMIN', agencyScope: true },
  });

  const clientOwner = await prisma.user.upsert({
    where: { email: 'demo-client-owner@example.com' },
    update: { name: 'Demo Client Owner', accountStatus: 'ACTIVE', passwordHash: demoPasswordHash },
    create: { email: 'demo-client-owner@example.com', name: 'Demo Client Owner', accountStatus: 'ACTIVE', passwordHash: demoPasswordHash },
  });

  await prisma.membership.upsert({
    where: { organizationId_userId: { organizationId: org.id, userId: clientOwner.id } },
    update: { roleId: clientOwnerRole.id, roleKey: 'CLIENT_OWNER', clientId: client.id, agencyScope: false },
    create: { organizationId: org.id, userId: clientOwner.id, roleId: clientOwnerRole.id, roleKey: 'CLIENT_OWNER', clientId: client.id },
  });

  const packageRecord = await prisma.package.findUniqueOrThrow({ where: { key: 'MarketplaceListing25' } });
  const directChannelId = salesChannelByKey.get('Direct');
  if (!directChannelId) throw new Error('Direct sales channel was not seeded.');

  const externalOrder = await prisma.externalOrder.upsert({
    where: { salesChannelId_externalOrderId: { salesChannelId: directChannelId, externalOrderId: 'DEMO-DIRECT-ORDER-001' } },
    update: {
      clientId: client.id,
      packageKey: packageRecord.key,
      buyerName: client.name,
      buyerEmailOrUsername: client.email,
      orderAmountCents: 9900,
      currency: 'USD',
      paymentStatus: 'MANUAL_CONFIRMED',
      uploadStatus: 'TOKEN_SENT',
      fulfillmentStatus: 'NOT_STARTED',
      channelName: 'Direct',
      dedupeKey: `${org.id}:direct:demo-direct-order-001`,
      normalizationStatus: 'NORMALIZED',
      mappingStatus: 'JOB_CREATED',
      normalizedPayload: { seed: true, channelName: 'Direct', externalOrderId: 'DEMO-DIRECT-ORDER-001', packageKey: packageRecord.key },
      revenueAttribution: { channelName: 'Direct', grossAmountCents: 9900, currency: 'USD', attributionSource: 'manual' },
      importedAt: new Date(),
    },
    create: {
      organizationId: org.id,
      salesChannelId: directChannelId,
      clientId: client.id,
      externalOrderId: 'DEMO-DIRECT-ORDER-001',
      externalCustomerId: 'DEMO-CUSTOMER-001',
      buyerName: client.name,
      buyerEmailOrUsername: client.email,
      packageKey: packageRecord.key,
      orderAmountCents: 9900,
      currency: 'USD',
      revisionAllowance: 2,
      paymentStatus: 'MANUAL_CONFIRMED',
      uploadStatus: 'TOKEN_SENT',
      fulfillmentStatus: 'NOT_STARTED',
      channelName: 'Direct',
      packagePurchasedRaw: packageRecord.key,
      sourceFingerprint: 'seed-direct-demo-order-001',
      dedupeKey: `${org.id}:direct:demo-direct-order-001`,
      normalizationStatus: 'NORMALIZED',
      mappingStatus: 'JOB_CREATED',
      normalizedPayload: { seed: true, channelName: 'Direct', externalOrderId: 'DEMO-DIRECT-ORDER-001', packageKey: packageRecord.key },
      revenueAttribution: { channelName: 'Direct', grossAmountCents: 9900, currency: 'USD', attributionSource: 'manual' },
      importedAt: new Date(),
      rawPayload: { source: 'seed', mode: 'manual' },
    },
  });

  const job = await prisma.job.upsert({
    where: { organizationId_jobNumber: { organizationId: org.id, jobNumber: 'JOB-DEMO-001' } },
    update: {
      clientId: client.id,
      salesChannelId: directChannelId,
      externalOrderId: externalOrder.id,
      packageId: packageRecord.id,
      title: 'Demo Marketplace Listing Pack',
      status: 'WAITING_FOR_UPLOAD',
      paymentStatus: 'MANUAL_CONFIRMED',
      uploadStatus: 'TOKEN_SENT',
      fulfillmentStatus: 'NOT_STARTED',
      sourceUrl: 'https://example.com/demo-direct-order-001',
      sourceChannelName: 'Direct',
      revenueAttribution: { channelName: 'Direct', externalOrderId: 'DEMO-DIRECT-ORDER-001', grossAmountCents: 9900, currency: 'USD', attributionSource: 'manual' },
    },
    create: {
      organizationId: org.id,
      clientId: client.id,
      salesChannelId: directChannelId,
      externalOrderId: externalOrder.id,
      packageId: packageRecord.id,
      jobNumber: 'JOB-DEMO-001',
      title: 'Demo Marketplace Listing Pack',
      status: 'WAITING_FOR_UPLOAD',
      paymentStatus: 'MANUAL_CONFIRMED',
      uploadStatus: 'TOKEN_SENT',
      fulfillmentStatus: 'NOT_STARTED',
      targetPlatform: 'Amazon, Etsy, Shopify',
      imageQuantity: 25,
      productCategory: 'Home goods',
      backgroundPreference: 'white and transparent',
      fileFormat: 'JPG, PNG, WebP',
      skuNamingPreference: 'SKU-first safe names',
      deliveryNotes: 'Platform-ready draft. Seller review recommended before publishing.',
      sourceUrl: 'https://example.com/demo-direct-order-001',
      sourceChannelName: 'Direct',
      revenueAttribution: { channelName: 'Direct', externalOrderId: 'DEMO-DIRECT-ORDER-001', grossAmountCents: 9900, currency: 'USD', attributionSource: 'manual' },
    },
  });

  const uploadToken = await prisma.uploadToken.upsert({
    where: { tokenHash: 'seed-upload-token-hash-demo-001' },
    update: {
      expiresAt: new Date('2099-01-01T00:00:00.000Z'),
      maxFiles: 50,
      maxBytesPerFile: 52428800,
      allowedMimeTypes: ['image/jpeg', 'image/png', 'image/webp', 'application/zip'],
      metadata: { seed: true, note: 'Demo hashed upload token. Public token is never stored.' },
    },
    create: {
      organizationId: org.id,
      clientId: client.id,
      jobId: job.id,
      tokenHash: 'seed-upload-token-hash-demo-001',
      purpose: 'UPLOAD',
      expiresAt: new Date('2099-01-01T00:00:00.000Z'),
      maxFiles: 50,
      maxBytesPerFile: 52428800,
      allowedMimeTypes: ['image/jpeg', 'image/png', 'image/webp', 'application/zip'],
      metadata: { seed: true, note: 'Demo hashed upload token. Public token is never stored.' },
    },
  });

  const uploadBatch = await prisma.uploadBatch.upsert({
    where: { id: 'seed-upload-batch-demo-001' },
    update: {
      status: 'ACCEPTED',
      fileCount: 1,
      acceptedFileCount: 1,
      rejectedFileCount: 0,
      totalBytes: BigInt(512000),
      metadata: { seed: true, source: 'phase8-direct-upload-file-intake' },
    },
    create: {
      id: 'seed-upload-batch-demo-001',
      organizationId: org.id,
      clientId: client.id,
      jobId: job.id,
      uploadTokenId: uploadToken.id,
      sourceKind: 'DIRECT_UPLOAD',
      status: 'ACCEPTED',
      fileCount: 1,
      acceptedFileCount: 1,
      rejectedFileCount: 0,
      totalBytes: BigInt(512000),
      clientNotes: 'Seed upload batch for Phase 8 direct upload intake.',
      metadata: { seed: true, source: 'phase8-direct-upload-file-intake' },
    },
  });

  const image = await prisma.image.upsert({
    where: { jobId_storageKey: { jobId: job.id, storageKey: 'demo/originals/demo-product-001.jpg' } },
    update: { originalName: 'demo-product-001.jpg', status: 'ORIGINAL_UPLOADED', uploadStatus: 'COMPLETE', uploadBatchId: uploadBatch.id, uploadTokenId: uploadToken.id, sourceKind: 'DIRECT_UPLOAD', validationStatus: 'ACCEPTED' },
    create: {
      organizationId: org.id,
      clientId: client.id,
      jobId: job.id,
      uploadBatchId: uploadBatch.id,
      uploadTokenId: uploadToken.id,
      sourceKind: 'DIRECT_UPLOAD',
      originalName: 'demo-product-001.jpg',
      originalRelativePath: 'demo-product-001.jpg',
      storageKey: 'demo/originals/demo-product-001.jpg',
      originalFileUrl: null,
      mimeType: 'image/jpeg',
      fileExtension: '.jpg',
      sizeBytes: 512000,
      width: 2000,
      height: 2000,
      sha256: 'demo-seed-not-a-real-file-hash',
      uploadStatus: 'COMPLETE',
      validationStatus: 'ACCEPTED',
      status: 'ORIGINAL_UPLOADED',
      qualityFlags: [],
      metadata: { seed: true },
    },
  });

  await prisma.uploadEvent.upsert({
    where: { id: 'seed-upload-event-demo-001' },
    update: { message: 'Seed original image accepted through Phase 8 intake.' },
    create: {
      id: 'seed-upload-event-demo-001',
      organizationId: org.id,
      clientId: client.id,
      jobId: job.id,
      uploadBatchId: uploadBatch.id,
      imageId: image.id,
      eventType: 'BATCH_ACCEPTED',
      severity: 'INFO',
      message: 'Seed original image accepted through Phase 8 intake.',
      metadata: { seed: true, originalsPreserved: true, finalDeliveryRequiresApproval: true },
    },
  });

  const processedFile = await prisma.processedFile.upsert({
    where: { jobId_storageKey: { jobId: job.id, storageKey: 'demo/processed/JOB-DEMO-001/White-JPG/demo-product-001_white.jpg' } },
    update: { status: 'READY_FOR_REVIEW', approvedStatus: 'PENDING' },
    create: {
      organizationId: org.id,
      jobId: job.id,
