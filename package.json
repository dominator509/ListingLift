{
  "name": "listinglift",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:adapter-contract": "vitest run tests/adapter-contract",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "test:migration": "prisma validate",
    "smoke": "tsx scripts/smoke.ts",
    "verify-env": "tsx scripts/verify-env.ts",
    "security-check": "vitest run tests/security && npm audit --audit-level=high",
    "db:generate": "tsx scripts/run-with-test-env.ts prisma generate",
    "db:validate": "tsx scripts/run-with-test-env.ts prisma validate",
    "db:migrate": "tsx scripts/run-with-test-env.ts prisma migrate deploy",
    "db:migrate:dev": "tsx scripts/run-with-test-env.ts prisma migrate dev",
    "db:seed": "tsx scripts/run-with-test-env.ts tsx prisma/seed.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:routes": "vitest run tests/routes",
    "test:services": "vitest run tests/services",
    "test:tenant": "vitest run tests/security/tenant-isolation.test.ts",
    "test:webhooks": "vitest run tests/security/webhook-signature.test.ts",
    "db:reset:dev": "prisma migrate reset --force --skip-generate && npm run db:seed",
    "repo:inventory": "tsx scripts/repo-inventory.ts",
    "test-all": "npm run verify-env && npm run db:validate && npm run db:generate && npm run db:migrate && npm run db:seed && npm run db:seed && npm run typecheck && npm run lint && npm run test:unit && npm run test:security && npm run test:integration && npm run test:adapter-contract && npm run test:e2e && npm run security-check && npm run build && npm run smoke",
    "qa:matrix": "tsx scripts/qa-matrix.ts",
    "qa:codex-required": "npm run qa:matrix && npm run test-all"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "latest",
    "bcryptjs": "latest",
    "clsx": "latest",
    "csv-stringify": "latest",
    "date-fns": "latest",
    "esbuild": "^0.28.1",
    "ioredis": "^5.11.1",
    "jszip": "latest",
    "nanoid": "latest",
    "next": "latest",
    "nodemailer": "^9.0.1",
    "pg-protocol": "^1.14.0",
    "react": "latest",
    "react-dom": "latest",
    "sharp": "latest",
    "stripe": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "latest",
    "@types/bcryptjs": "latest",
    "@types/node": "^25.9.2",
    "@types/nodemailer": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "latest",
    "postcss": "latest",
    "prettier": "latest",
    "prisma": "latest",
    "tailwindcss": "latest",
    "ts-node": "^10.9.2",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "overrides": {
    "@prisma/dev": {
      "@hono/node-server": "^1.19.13"
    }
  }
}
